// SurveyPrime 0.1 -- original implementation. Angles internally in degrees.
// Pure calculations are separate from keypad interaction.

SC_WRAP(a)
BEGIN
  RETURN a-360*FLOOR(a/360);
END;

SC_DMSOK(a)
BEGIN
  LOCAL x,d,m,s;
  x:=ABS(a); d:=FLOOR(x);
  m:=FLOOR((x-d)*100+0.00000001);
  s:=ROUND(((x-d)*100-m)*100,6);
  RETURN (m<60) AND (s<60) AND (s>=0);
END;

SC_DEC(a)
BEGIN
  LOCAL x,d,m,s,sg:=1;
  IF a<0 THEN sg:=-1; END;
  x:=ABS(a); d:=FLOOR(x);
  m:=FLOOR((x-d)*100+0.00000001);
  s:=ROUND(((x-d)*100-m)*100,6);
  RETURN sg*(d+m/60+s/3600);
END;

SC_PACK(a)
BEGIN
  LOCAL t,d,m,s,sg:=1;
  IF a<0 THEN sg:=-1; END;
  t:=ROUND(ABS(a)*3600,3);
  d:=FLOOR(t/3600); t:=t-3600*d;
  m:=FLOOR(t/60); s:=t-60*m;
  RETURN sg*(d+m/100+s/10000);
END;

SC_AZ(e,n)
BEGIN
  LOCAL a;
  IF ABS(e)+ABS(n)<1E-12 THEN RETURN 0; END;
  IF ABS(n)<1E-12 THEN
    IF e>0 THEN RETURN 90; ELSE RETURN 270; END;
  END;
  a:=ATAN(e/n);
  IF n<0 THEN a:=a+180; END;
  RETURN SC_WRAP(a);
END;

SC_JOIN(e1,n1,e2,n2)
BEGIN
  LOCAL e:=e2-e1,n:=n2-n1;
  RETURN {SC_AZ(e,n),SQRT(e*e+n*n)};
END;

SC_RAD(e,n,b,d)
BEGIN
  RETURN {e+d*SIN(b),n+d*COS(b)};
END;

// Legs: {azimuth degrees, chord/straight distance, signed segment area}.
// Positive segment adds to absolute polygon area; negative subtracts.
SC_CLOSE(legs)
BEGIN
  LOCAL e:=0,n:=0,x,y,p:=0,a:=0,seg:=0,i,b,d,mis,ratio:=0;
  FOR i FROM 1 TO SIZE(legs) DO
    b:=legs(i)(1); d:=legs(i)(2);
    x:=e+d*SIN(b); y:=n+d*COS(b);
    a:=a+e*y-x*n; seg:=seg+legs(i)(3);
    e:=x; n:=y; p:=p+d;
  END;
  mis:=SQRT(e*e+n*n);
  IF mis>1E-9 THEN ratio:=p/mis; END;
  // Error vector is endpoint minus target; closing vector is its negative.
  RETURN {e,n,mis,SC_AZ(-e,-n),p,ABS(a)/2+seg,ratio};
END;

SC_COORDS(legs,e0,n0)
BEGIN
  LOCAL out:={{e0,n0}},i,p:={e0,n0};
  FOR i FROM 1 TO SIZE(legs) DO
    p:=SC_RAD(p(1),p(2),legs(i)(1),legs(i)(2));
    out:=CONCAT(out,{p});
  END;
  RETURN out;
END;

// Bowditch to an arbitrary target displacement. Original observations retained.
SC_BOW(legs,te,tn)
BEGIN
  LOCAL r:=SC_CLOSE(legs),out:={},i,e,n,d,b,w;
  FOR i FROM 1 TO SIZE(legs) DO
    b:=legs(i)(1); d:=legs(i)(2); w:=d/r(5);
    e:=d*SIN(b)+(te-r(1))*w;
    n:=d*COS(b)+(tn-r(2))*w;
    out:=CONCAT(out,{{SC_AZ(e,n),SQRT(e*e+n*n),legs(i)(3)}});
  END;
  RETURN out;
END;

SC_SEG(r,ch)
BEGIN
  LOCAL t:=2*ASIN(ch/(2*r));
  RETURN r*r*(t*3.141592653589793/180-SIN(t))/2;
END;

SC_INSERT(legs,pos,leg)
BEGIN
  LOCAL out:={},i;
  FOR i FROM 1 TO SIZE(legs)+1 DO
    IF i==pos THEN out:=CONCAT(out,{leg}); END;
    IF i<=SIZE(legs) THEN out:=CONCAT(out,{legs(i)}); END;
  END;
  RETURN out;
END;

SC_DELETE(legs,pos)
BEGIN
  LOCAL out:={},i;
  FOR i FROM 1 TO SIZE(legs) DO
    IF i<>pos THEN out:=CONCAT(out,{legs(i)}); END;
  END;
  RETURN out;
END;

SC_REVERSE(legs)
BEGIN
  LOCAL out:={},i;
  FOR i FROM SIZE(legs) DOWNTO 1 DO
    out:=CONCAT(out,{{SC_WRAP(legs(i)(1)+180),legs(i)(2),legs(i)(3)}});
  END;
  RETURN out;
END;

// Two unknown positive distances at known azimuths. Empty result if singular.
SC_2DIST(e,n,b1,b2)
BEGIN
  LOCAL det:=SIN(b1-b2),d1,d2;
  IF ABS(det)<1E-10 THEN RETURN {}; END;
  d1:=(e*COS(b2)-n*SIN(b2))/det;
  d2:=(n*SIN(b1)-e*COS(b1))/det;
  IF (d1<=0) OR (d2<=0) THEN RETURN {}; END;
  RETURN {d1,d2};
END;

// Two unknown azimuths at known distances: both mirror solutions returned.
SC_2BEAR(e,n,d1,d2)
BEGIN
  LOCAL r:=SQRT(e*e+n*n),b,c,t,p;
  IF (r<1E-10) OR (d1<=0) OR (d2<=0) THEN RETURN {}; END;
  c:=(r*r+d1*d1-d2*d2)/(2*r*d1);
  IF ABS(c)>1+1E-10 THEN RETURN {}; END;
  c:=MAX(-1,MIN(1,c)); b:=SC_AZ(e,n); t:=ACOS(c);
  p:=SC_RAD(0,0,b+t,d1);
  RETURN {SC_WRAP(b+t),SC_AZ(e-p(1),n-p(2)),
          SC_WRAP(b-t),SC_WRAP(2*b-SC_AZ(e-p(1),n-p(2)))};
END;

// Unknown azimuth on length d and unknown length on azimuth b.
SC_MIXED(e,n,d,b)
BEGIN
  LOCAL along:=e*SIN(b)+n*COS(b),cross:=e*COS(b)-n*SIN(b),q,out:={},x,p;
  q:=d*d-cross*cross;
  IF q<0 THEN RETURN {}; END;
  q:=SQRT(q);
  x:=along+q;
  IF x>0 THEN
    p:=SC_RAD(0,0,b,x); out:=CONCAT(out,{{SC_AZ(e-p(1),n-p(2)),x}});
  END;
  x:=along-q;
  IF (x>0) AND (q>1E-10) THEN
    p:=SC_RAD(0,0,b,x); out:=CONCAT(out,{{SC_AZ(e-p(1),n-p(2)),x}});
  END;
  RETURN out;
END;

SC_DFACT(u)
BEGIN
  LOCAL f:={1,0.3048,1200/3937,0.201168,20.1168,1000,0.0254};
  RETURN f(u);
END;

SC_AFACT(u)
BEGIN
  LOCAL f:={1,10000,0.09290304,(1200/3937)^2,4046.8564224,1000000};
  RETURN f(u);
END;

// Planar COGO: all coordinates metres, all azimuths decimal degrees.
SC_BB(e1,n1,b1,e2,n2,b2)
BEGIN
  LOCAL d:=SIN(b1-b2),t,u;
  IF ABS(d)<1E-10 THEN RETURN {}; END;
  t:=((e2-e1)*COS(b2)-(n2-n1)*SIN(b2))/d;
  u:=((e2-e1)*COS(b1)-(n2-n1)*SIN(b1))/d;
  RETURN {e1+t*SIN(b1),n1+t*COS(b1),t,u};
END;

SC_DD(e1,n1,r1,e2,n2,r2)
BEGIN
  LOCAL j:=SC_JOIN(e1,n1,e2,n2),d:=j(2),a,h,p;
  IF (d<1E-10) OR (r1<=0) OR (r2<=0) THEN RETURN {}; END;
  IF (d>r1+r2+1E-9) OR (d<ABS(r1-r2)-1E-9) THEN RETURN {}; END;
  a:=(r1*r1-r2*r2+d*d)/(2*d); h:=SQRT(MAX(0,r1*r1-a*a));
  p:=SC_RAD(e1,n1,j(1),a);
  RETURN {{p(1)+h*COS(j(1)),p(2)-h*SIN(j(1))},
          {p(1)-h*COS(j(1)),p(2)+h*SIN(j(1))}};
END;

SC_BD(e1,n1,b,e2,n2,r)
BEGIN
  LOCAL de:=e2-e1,dn:=n2-n1,t,q,out:={};
  t:=de*SIN(b)+dn*COS(b); q:=r*r-(de*COS(b)-dn*SIN(b))^2;
  IF (r<=0) OR (q<0) THEN RETURN {}; END;
  q:=SQRT(q);
  IF t+q>=0 THEN out:=CONCAT(out,{SC_RAD(e1,n1,b,t+q)}); END;
  IF (t-q>=0) AND (q>1E-9) THEN out:=CONCAT(out,{SC_RAD(e1,n1,b,t-q)}); END;
  RETURN out;
END;

SC_OFFSET(e1,n1,b,e,n)
BEGIN
  LOCAL de:=e-e1,dn:=n-n1;
  RETURN {de*SIN(b)+dn*COS(b),de*COS(b)-dn*SIN(b)};
END;

SC_CHAIN(e,n,b,ch,off)
BEGIN
  RETURN {e+ch*SIN(b)+off*COS(b),n+ch*COS(b)-off*SIN(b)};
END;

SC_CURVE(r,delta)
BEGIN
  RETURN {r*delta*3.141592653589793/180,2*r*SIN(delta/2),
          r*TAN(delta/2),r*(1-COS(delta/2)),r*(1/COS(delta/2)-1),SC_SEG(r,2*r*SIN(delta/2))};
END;

SC_HEIGHT(s,z,hi,ht,k)
BEGIN
  LOCAL hd:=s*SIN(z),dh:=s*COS(z)+hi-ht;
  RETURN {hd,dh+(1-k)*hd*hd/(2*6371000)};
END;

SC_FACES(h1,z1,s1,h2,z2,s2)
BEGIN
  LOCAL dh:=SC_WRAP(h2-h1)-180;
  RETURN {SC_WRAP(h1+dh/2),(z1+360-z2)/2,(s1+s2)/2,dh,(z1+z2-360)/2};
END;

SC_POLYAREA(pts)
BEGIN
  LOCAL a:=0,i,j,e0,n0;
  IF SIZE(pts)<3 THEN RETURN 0; END;
  e0:=pts(1)(1); n0:=pts(1)(2);
  FOR i FROM 1 TO SIZE(pts) DO
    j:=1+(i MOD SIZE(pts));
    a:=a+(pts(i)(1)-e0)*(pts(j)(2)-n0)-(pts(j)(1)-e0)*(pts(i)(2)-n0);
  END;
  RETURN ABS(a)/2;
END;

// Clip a simple polygon by an infinite line; retain left coordinate <= cut.
SC_CLIP(pts,b,cut)
BEGIN
  LOCAL out:={},i,j,p,q,u,v,t;
  FOR i FROM 1 TO SIZE(pts) DO
    j:=1+(i MOD SIZE(pts)); p:=pts(i); q:=pts(j);
    u:=p(1)*COS(b)-p(2)*SIN(b); v:=q(1)*COS(b)-q(2)*SIN(b);
    IF u<=cut THEN out:=CONCAT(out,{p}); END;
    IF ((u<=cut) AND (v>cut)) OR ((u>cut) AND (v<=cut)) THEN
      t:=(cut-u)/(v-u); out:=CONCAT(out,{{p(1)+t*(q(1)-p(1)),p(2)+t*(q(2)-p(2))}});
    END;
  END;
  RETURN out;
END;

SC_CUT(pts,b,target)
BEGIN
  LOCAL lo:=1E99,hi:=-1E99,i,u,mid,clipped;
  FOR i FROM 1 TO SIZE(pts) DO
    u:=pts(i)(1)*COS(b)-pts(i)(2)*SIN(b); lo:=MIN(lo,u); hi:=MAX(hi,u);
  END;
  FOR i FROM 1 TO 60 DO
    mid:=(lo+hi)/2; clipped:=SC_CLIP(pts,b,mid);
    IF SC_POLYAREA(clipped)<target THEN lo:=mid; ELSE hi:=mid; END;
  END;
  RETURN {mid,SC_POLYAREA(clipped)};
END;

// Three-point resection from clockwise direction differences B-A and C-A.
// Multistart Newton iteration rejects singular geometry and multiple solutions.
SC_RESECT(pts,ab,ac)
BEGIN
  LOCAL ce:=0,cn:=0,size:=0,start,iter,i,e,n,de,dn,rr,b,gE,gN,
    dirs,ges,gns,f1,f2,j11,j12,j21,j22,det,dx,dy,solutions:={},p,good;
  FOR i FROM 1 TO 3 DO ce:=ce+pts(i)(1)/3; cn:=cn+pts(i)(2)/3; END;
  FOR i FROM 1 TO 3 DO size:=MAX(size,SQRT((pts(i)(1)-ce)^2+(pts(i)(2)-cn)^2)); END;
  IF size<1E-6 THEN RETURN {}; END;
  FOR start FROM 1 TO 12 DO
    e:=ce+1.37*size*SIN(start*30+7); n:=cn+1.37*size*COS(start*30+7); good:=0;
    FOR iter FROM 1 TO 70 DO
      dirs:={}; ges:={}; gns:={};
      FOR i FROM 1 TO 3 DO
        de:=pts(i)(1)-e; dn:=pts(i)(2)-n; rr:=MAX(1E-12,de*de+dn*dn);
        dirs:=CONCAT(dirs,{SC_AZ(de,dn)});
        ges:=CONCAT(ges,{-dn/rr*180/3.141592653589793});
        gns:=CONCAT(gns,{de/rr*180/3.141592653589793});
      END;
      f1:=SC_WRAP(dirs(2)-dirs(1)-ab+180)-180;
      f2:=SC_WRAP(dirs(3)-dirs(1)-ac+180)-180;
      j11:=ges(2)-ges(1); j12:=gns(2)-gns(1);
      j21:=ges(3)-ges(1); j22:=gns(3)-gns(1); det:=j11*j22-j12*j21;
      IF ABS(det)>1E-14 THEN
        dx:=(-f1*j22+j12*f2)/det; dy:=(-j11*f2+f1*j21)/det;
        rr:=SQRT(dx*dx+dy*dy);
        IF rr>size THEN dx:=dx*size/rr; dy:=dy*size/rr; END;
        e:=e+dx; n:=n+dy;
        good:=(ABS(f1)+ABS(f2)<1E-8);
      END;
    END;
    IF good AND (ABS(det)>1E-12) THEN
      p:=SC_JOIN(e,n,pts(1)(1),pts(1)(2));
      IF SIZE(solutions)==0 THEN solutions:={e,n,p(1)};
      ELSE
        IF ABS(e-solutions(1))+ABS(n-solutions(2))>0.001 THEN RETURN {}; END;
      END;
    END;
  END;
  RETURN solutions;
END;

// Level observations {backsight,foresight,distance}; proportional correction.
SC_LEVEL(rows,start,finish,bydist)
BEGIN
  LOCAL i,total:=0,error,rl:=start,raw:={},out:={},cum:=0,w;
  FOR i FROM 1 TO SIZE(rows) DO
    rl:=rl+rows(i)(1)-rows(i)(2); raw:=CONCAT(raw,{rl});
    IF bydist THEN total:=total+rows(i)(3); ELSE total:=total+1; END;
  END;
  error:=rl-finish;
  FOR i FROM 1 TO SIZE(rows) DO
    IF bydist THEN cum:=cum+rows(i)(3); ELSE cum:=cum+1; END;
    w:=cum/total; out:=CONCAT(out,{{raw(i),raw(i)-error*w}});
  END;
  RETURN {error,out};
END;

// Road segment {length, entry curvature, exit curvature}, right positive (1/m).
// Simpson integration supports straight, circular and clothoid elements.
SC_ROADSTEP(e,n,b,leg,s)
BEGIN
  LOCAL slices,i,t,w,theta,se:=0,sn:=0,h,k0:=leg(2),dk:=(leg(3)-leg(2))/leg(1);
  theta:=ABS(k0*s+dk*s*s/2);
  slices:=MAX(20,2*CEILING(theta*40)); h:=s/slices;
  FOR i FROM 0 TO slices DO
    t:=i*h; theta:=b+(k0*t+dk*t*t/2)*180/3.141592653589793;
    w:=2; IF i MOD 2 THEN w:=4; END;
    IF (i==0) OR (i==slices) THEN w:=1; END;
    se:=se+w*SIN(theta); sn:=sn+w*COS(theta);
  END;
  RETURN {e+se*h/3,n+sn*h/3,SC_WRAP(b+(k0*s+dk*s*s/2)*180/3.141592653589793),k0+dk*s};
END;

SC_ROAD(legs,origin,chain,offset)
BEGIN
  LOCAL p:={origin(1),origin(2),origin(3),0},left:=chain-origin(4),i,s;
  FOR i FROM 1 TO SIZE(legs) DO
    IF left>=0 THEN
      s:=MIN(left,legs(i)(1)); p:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),s);
      left:=left-legs(i)(1);
    END;
  END;
  RETURN {p(1)+offset*COS(p(3)),p(2)-offset*SIN(p(3)),p(3),p(4)};
END;

SC_ECC(e1,n1,e2,n2,d,angle)
BEGIN
  LOCAL j:=SC_JOIN(e1,n1,e2,n2),h,r,c,pts,out:={},side,i,a,b,duplicate,k;
  IF (d<=0) OR (j(2)<1E-9) OR (ABS(SIN(angle))<1E-9) THEN RETURN {}; END;
  h:=j(2)/(2*TAN(angle)); r:=ABS(j(2)/(2*SIN(angle)));
  FOR side FROM 1 TO 2 DO
    c:={(e1+e2)/2+(3-2*side)*h*COS(j(1)),(n1+n2)/2-(3-2*side)*h*SIN(j(1))};
    pts:=SC_DD(e1,n1,d,c(1),c(2),r);
    FOR i FROM 1 TO SIZE(pts) DO
      a:=SC_AZ(e1-pts(i)(1),n1-pts(i)(2)); b:=SC_AZ(e2-pts(i)(1),n2-pts(i)(2));
      IF ABS(SC_WRAP(b-a-angle+180)-180)<1E-6 THEN
        duplicate:=0;
        FOR k FROM 1 TO SIZE(out) DO
          IF ABS(out(k)(1)-pts(i)(1))+ABS(out(k)(2)-pts(i)(2))<1E-5 THEN duplicate:=1; END;
        END;
        IF duplicate==0 THEN out:=CONCAT(out,{pts(i)}); END;
      END;
    END;
  END;
  RETURN out;
END;

SC_ROADNEAR(legs,origin,e,n)
BEGIN
  LOCAL p:={origin(1),origin(2),origin(3),0},i,j,ch:=origin(4),q,d,best:=1E99,
    bestch:=ch,bestp:=p,bests:=0,lo,hi,m1,m2,q1,q2,d1,d2,s;
  FOR i FROM 1 TO SIZE(legs) DO
    d:=1E99;
    FOR j FROM 0 TO 40 DO
      s:=legs(i)(1)*j/40; q:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),s);
      d1:=(e-q(1))^2+(n-q(2))^2;
      IF d1<d THEN d:=d1; bests:=s; END;
    END;
    lo:=MAX(0,bests-legs(i)(1)/40); hi:=MIN(legs(i)(1),bests+legs(i)(1)/40);
    FOR j FROM 1 TO 45 DO
      m1:=lo+(hi-lo)/3; m2:=hi-(hi-lo)/3;
      q1:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),m1); q2:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),m2);
      d1:=(e-q1(1))^2+(n-q1(2))^2; d2:=(e-q2(1))^2+(n-q2(2))^2;
      IF d1<d2 THEN hi:=m2; ELSE lo:=m1; END;
    END;
    s:=(lo+hi)/2; q:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),s);
    d1:=(e-q(1))^2+(n-q(2))^2;
    IF d1<best THEN best:=d1; bestch:=ch+s; bestp:=q; END;
    ch:=ch+legs(i)(1); p:=SC_ROADSTEP(p(1),p(2),p(3),legs(i),legs(i)(1));
  END;
  q:=SC_OFFSET(bestp(1),bestp(2),bestp(3),e,n);
  RETURN {bestch,q(2),SQRT(best),q(1)};
END;

// Transverse Mercator: Snyder, USGS Professional Paper 1395, series through A^6.
// Configuration: {a, inverse flattening, lon0, lat0, k0, false E, false N}.






SC_MERID(phi,cfg)
BEGIN
  LOCAL f:=1/cfg(2),es:=f*(2-f),p:=phi*3.141592653589793/180;
  RETURN cfg(1)*((1-es/4-3*es^2/64-5*es^3/256)*p
    -(3*es/8+3*es^2/32+45*es^3/1024)*SIN(2*phi)
    +(15*es^2/256+45*es^3/1024)*SIN(4*phi)-35*es^3/3072*SIN(6*phi));
END;

SC_GRID(lat,lon,cfg)
BEGIN
  LOCAL f:=1/cfg(2),es:=f*(2-f),ep:=es/(1-es),nu,t,cc,a,m,e,n,k,g;
  nu:=cfg(1)/SQRT(1-es*SIN(lat)^2); t:=TAN(lat)^2; cc:=ep*COS(lat)^2;
  a:=(lon-cfg(3))*3.141592653589793/180*COS(lat); m:=SC_MERID(lat,cfg)-SC_MERID(cfg(4),cfg);
  e:=cfg(6)+cfg(5)*nu*(a+(1-t+cc)*a^3/6+(5-18*t+t*t+72*cc-58*ep)*a^5/120);
  n:=cfg(7)+cfg(5)*(m+nu*TAN(lat)*(a*a/2+(5-t+9*cc+4*cc*cc)*a^4/24+(61-58*t+t*t+600*cc-330*ep)*a^6/720));
  k:=cfg(5)*(1+(1+cc)*a*a/2+(5-4*t+42*cc+13*cc*cc-28*ep)*a^4/24
    +(61-148*t+16*t*t)*a^6/720);
  g:=ATAN(TAN(lon-cfg(3))*SIN(lat));
  RETURN {e,n,k,g};
END;

SC_UNGRID(e,n,cfg)
BEGIN
  LOCAL f:=1/cfg(2),es:=f*(2-f),ep:=es/(1-es),m,mu,e1,phi,c,t,nu,r,d,lat,lon;
  m:=(n-cfg(7))/cfg(5)+SC_MERID(cfg(4),cfg);
  mu:=m/(cfg(1)*(1-es/4-3*es^2/64-5*es^3/256))*180/3.141592653589793;
  e1:=(1-SQRT(1-es))/(1+SQRT(1-es));
  phi:=mu+((3*e1/2-27*e1^3/32)*SIN(2*mu)+(21*e1^2/16-55*e1^4/32)*SIN(4*mu)
    +151*e1^3/96*SIN(6*mu)+1097*e1^4/512*SIN(8*mu))*180/3.141592653589793;
  c:=ep*COS(phi)^2; t:=TAN(phi)^2; nu:=cfg(1)/SQRT(1-es*SIN(phi)^2);
  r:=cfg(1)*(1-es)/(1-es*SIN(phi)^2)^1.5; d:=(e-cfg(6))/(nu*cfg(5));
  lat:=phi-nu*TAN(phi)/r*(d*d/2-(5+3*t+10*c-4*c*c-9*ep)*d^4/24
    +(61+90*t+298*c+45*t*t-252*ep-3*c*c)*d^6/720)*180/3.141592653589793;
  lon:=cfg(3)+(d-(1+2*t+c)*d^3/6+(5-2*c+28*t-3*c*c+8*ep+24*t*t)*d^5/120)/COS(phi)*180/3.141592653589793;
  RETURN {lat,lon};
END;

SC_ECEF(lat,lon,h,cfg)
BEGIN
  LOCAL f:=1/cfg(2),es:=f*(2-f),nu:=cfg(1)/SQRT(1-es*SIN(lat)^2);
  RETURN {(nu+h)*COS(lat)*COS(lon),(nu+h)*COS(lat)*SIN(lon),(nu*(1-es)+h)*SIN(lat)};
END;

SC_UNECEF(x,y,z,cfg)
BEGIN
  LOCAL f:=1/cfg(2),es:=f*(2-f),p:=SQRT(x*x+y*y),lat,nu,h,i,lon;
  lon:=SC_WRAP(SC_AZ(y,x)+180)-180;
  IF p<1E-8 THEN
    lat:=90; IF z<0 THEN lat:=-90; END;
    RETURN {lat,0,ABS(z)-cfg(1)*(1-f)};
  END;
  lat:=ATAN(z/(p*(1-es)));
  FOR i FROM 1 TO 12 DO
    nu:=cfg(1)/SQRT(1-es*SIN(lat)^2); lat:=ATAN((z+es*nu*SIN(lat))/p);
  END;
  nu:=cfg(1)/SQRT(1-es*SIN(lat)^2); h:=p/COS(lat)-nu;
  RETURN {lat,lon,h};
END;

// Position-vector convention: translations metres, rotations arcseconds, scale ppm.
SC_HELMERT(xyz,par)
BEGIN
  LOCAL rx:=par(4)*3.141592653589793/648000,ry:=par(5)*3.141592653589793/648000,
    rz:=par(6)*3.141592653589793/648000,s:=1+par(7)*1E-6,x:=xyz(1),y:=xyz(2),z:=xyz(3);
  RETURN {par(1)+s*(x-rz*y+ry*z),par(2)+s*(rz*x+y-rx*z),par(3)+s*(-ry*x+rx*y+z)};
END;

// Vincenty inverse. Non-convergent near-antipodal cases return an empty list.
SC_VINCENTY(lat1,lon1,lat2,lon2,cfg)
BEGIN
  LOCAL f:=1/cfg(2),a:=cfg(1),b:=a*(1-f),u1:=ATAN((1-f)*TAN(lat1)),u2:=ATAN((1-f)*TAN(lat2)),
    ll:=SC_WRAP(lon2-lon1+180)-180,lambda:=ll,old,ss,cs,sigma,sa,ca2,c2,c,us,aa,bb,ds,s,i;
  IF (ABS(lat1-lat2)+ABS(ll))<1E-12 THEN RETURN {0,0,0}; END;
  FOR i FROM 1 TO 200 DO
    ss:=SQRT((COS(u2)*SIN(lambda))^2+(COS(u1)*SIN(u2)-SIN(u1)*COS(u2)*COS(lambda))^2);
    IF ss<1E-14 THEN RETURN {}; END;
    cs:=SIN(u1)*SIN(u2)+COS(u1)*COS(u2)*COS(lambda); sigma:=SC_AZ(ss,cs)*3.141592653589793/180;
    sa:=COS(u1)*COS(u2)*SIN(lambda)/ss; ca2:=1-sa*sa; c2:=0;
    IF ca2>1E-14 THEN c2:=cs-2*SIN(u1)*SIN(u2)/ca2; END;
    c:=f/16*ca2*(4+f*(4-3*ca2)); old:=lambda;
    lambda:=ll+(1-c)*f*sa*(sigma+c*ss*(c2+c*cs*(-1+2*c2*c2)))*180/3.141592653589793;
  END;
  IF ABS(lambda-old)>1E-9 THEN RETURN {}; END;
  us:=ca2*(a*a-b*b)/(b*b); aa:=1+us/16384*(4096+us*(-768+us*(320-175*us)));
  bb:=us/1024*(256+us*(-128+us*(74-47*us)));
  ds:=bb*ss*(c2+bb/4*(cs*(-1+2*c2*c2)-bb/6*c2*(-3+4*ss*ss)*(-3+4*c2*c2)));
  s:=b*aa*(sigma-ds);
  RETURN {s,SC_AZ(COS(u2)*SIN(lambda),COS(u1)*SIN(u2)-SIN(u1)*COS(u2)*COS(lambda)),
    SC_WRAP(SC_AZ(COS(u1)*SIN(lambda),-SIN(u1)*COS(u2)+COS(u1)*SIN(u2)*COS(lambda))+180)};
END;

SC_GEODUI()
BEGIN
  LOCAL c,r,out,p,q,i,a,b,par,k,heights;
  REPEAT
    c:=SC_MENU("GEODESY | explicit projection",{"Ellipsoid / projection settings","Latitude / longitude to grid","Grid to latitude / longitude","Geodetic <-> Cartesian XYZ","Seven-parameter transform","Ellipsoidal inverse / grid join","Grid / ground distance","Grid radiation and block shift","Geodetic point jobs / CSV"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      i:=SC_MENU("Projection setup",{"UTM / MGA zone (GRS80)","UTM zone (WGS84)","Custom Transverse Mercator","View current parameters"});
      IF (i==1) OR (i==2) THEN
        r:=SC_FORM("UTM configuration",{"UTM zone 1..60","Hemisphere: 1 South / 0 North"},{56,1});
        IF SIZE(r)>0 THEN
          IF (r(1)>=1) AND (r(1)<=60) AND (r(1)==FLOOR(r(1))) AND ((r(2)==0) OR (r(2)==1)) THEN
            a:=298.257222101; IF i==2 THEN a:=298.257223563; END;
            SC_PROJ:={6378137,a,6*r(1)-183,0,0.9996,500000,10000000*r(2)};
          ELSE SC_SHOW("Invalid UTM setup",{"Zone 1..60 and hemisphere 0 or 1."}); END;
        END;
      END;
      IF i==3 THEN
        r:=SC_FORM("Custom projection",{"Semi-major axis a (m)","Inverse flattening","Central meridian (decimal deg)","Origin latitude (decimal deg)","Central scale k0","False Easting (m)","False Northing (m)"},SC_PROJ);
        IF SIZE(r)>0 THEN
          IF (r(1)>0) AND (r(2)>100) AND (r(5)>0) AND (ABS(r(4))<85) AND (ABS(r(3))<=180) THEN SC_PROJ:=r;
          ELSE SC_SHOW("Invalid projection",{"Check ellipsoid, scale and origin."}); END;
        END;
      END;
      IF i==4 THEN SC_SHOW("Projection parameters",{"a: "+STRING(SC_PROJ(1)),"1/f: "+STRING(SC_PROJ(2)),"Lon0: "+STRING(SC_PROJ(3)),"Lat0: "+STRING(SC_PROJ(4)),"k0: "+STRING(SC_PROJ(5)),"False E: "+STRING(SC_PROJ(6)),"False N: "+STRING(SC_PROJ(7)),"Ellipsoid alone does not define a datum.","Use appropriate epoch / transform parameters."}); END;
    END;
    IF c==2 THEN
      r:=SC_FORM("Geodetic to grid",{"Latitude decimal degrees (South negative)","Longitude decimal degrees (East positive)"},{-33,151});
      IF SIZE(r)>0 THEN
        IF (r(1)>=-80) AND (r(1)<=84) AND (ABS(r(2)-SC_PROJ(3))<=3.5) THEN
          out:=SC_GRID(r(1),r(2),SC_PROJ);
          SC_SHOW("Grid coordinate",{"E "+SC_FMT(out(1)),"N "+SC_FMT(out(2)),"Point scale: "+STRING(out(3)),"Convergence (approx): "+SC_ANGLE(out(4)),"Series valid within 3.5 deg of lon0."});
        ELSE SC_SHOW("Outside supported grid domain",{"Latitude -80..84; longitude within 3.5d of lon0."}); END;
      END;
    END;
    IF c==3 THEN
      r:=SC_FORM("Grid to geodetic",{"Grid Easting (m)","Grid Northing (m)"},{SC_PROJ(6),SC_PROJ(7)});
      IF SIZE(r)>0 THEN
        out:=SC_UNGRID(r(1),r(2),SC_PROJ);
        IF (out(1)>=-80) AND (out(1)<=84) AND (ABS(out(2)-SC_PROJ(3))<=3.5) THEN
          SC_SHOW("Geodetic coordinate",{"Latitude: "+STRING(out(1)),"Longitude: "+STRING(out(2)),SC_ANGLE(out(1)),SC_ANGLE(out(2))});
        ELSE SC_SHOW("Outside supported grid domain",{"Check grid zone, hemisphere and coordinates."}); END;
      END;
    END;
    IF c==4 THEN
      i:=SC_MENU("Cartesian conversion",{"Latitude / longitude / h to XYZ","XYZ to latitude / longitude / h"});
      IF i==1 THEN
        r:=SC_FORM("Geodetic to XYZ",{"Latitude decimal deg","Longitude decimal deg","Ellipsoidal height (m)"},{-33,151,0});
        IF SIZE(r)>0 THEN IF (ABS(r(1))<=90) AND (ABS(r(2))<=180) THEN out:=SC_ECEF(r(1),r(2),r(3),SC_PROJ); SC_SHOW("Cartesian XYZ",{"X "+SC_FMT(out(1)),"Y "+SC_FMT(out(2)),"Z "+SC_FMT(out(3))}); END; END;
      END;
      IF i==2 THEN
        r:=SC_FORM("XYZ to geodetic",{"X (m)","Y (m)","Z (m)"},{6378137,0,0});
        IF SIZE(r)>0 THEN
          IF ABS(r(1))+ABS(r(2))+ABS(r(3))>1 THEN out:=SC_UNECEF(r(1),r(2),r(3),SC_PROJ); SC_SHOW("Geodetic",{"Lat "+STRING(out(1)),"Lon "+STRING(out(2)),"Ellipsoidal h "+SC_FMT(out(3))}); END;
        END;
      END;
    END;
    IF c==5 THEN
      r:=SC_FORM("Position-vector transform",{"X (m)","Y (m)","Z (m)"},{0,0,0});
      IF SIZE(r)>0 THEN
        par:=SC_FORM("Transform parameters",{"Translation X (m)","Translation Y (m)","Translation Z (m)","Rotation X (arcseconds)","Rotation Y (arcseconds)","Rotation Z (arcseconds)","Scale (ppm)"},{0,0,0,0,0,0,0});
        IF SIZE(par)>0 THEN out:=SC_HELMERT(r,par); SC_SHOW("Transformed XYZ",{"X "+SC_FMT(out(1)),"Y "+SC_FMT(out(2)),"Z "+SC_FMT(out(3)),"Position-vector convention."}); END;
      END;
    END;
    IF c==6 THEN
      r:=SC_FORM("Ellipsoidal inverse",{"A latitude decimal deg","A longitude decimal deg","B latitude decimal deg","B longitude decimal deg"},{-33,151,-33.1,151.1});
      IF SIZE(r)>0 THEN
        IF (ABS(r(1))<90) AND (ABS(r(3))<90) AND (ABS(r(2))<=180) AND (ABS(r(4))<=180) THEN
          out:=SC_VINCENTY(r(1),r(2),r(3),r(4),SC_PROJ);
          IF SIZE(out)>0 THEN
            SC_SHOW("Ellipsoidal inverse",{"Distance: "+SC_FMT(out(1))+" m","Forward azimuth: "+SC_ANGLE(out(2)),"Reverse azimuth: "+SC_ANGLE(out(3)),"Selected ellipsoid; height not included."});
            IF (ABS(r(2)-SC_PROJ(3))<=3.5) AND (ABS(r(4)-SC_PROJ(3))<=3.5) THEN
              p:=SC_GRID(r(1),r(2),SC_PROJ); q:=SC_GRID(r(3),r(4),SC_PROJ); a:=SC_JOIN(p(1),p(2),q(1),q(2));
              SC_SHOW("Grid chord / scale",{"Grid bearing: "+SC_ANGLE(a(1)),"Grid distance: "+SC_FMT(a(2)),"Line scale: "+STRING(a(2)/MAX(out(1),1E-12)),
                "Plane minus grid-bearing azimuth:",SC_ANGLE(out(2)-p(4)-a(1)),"Convergence / arc-to-chord approximate."});
            END;
          ELSE SC_SHOW("Inverse did not converge",{"Near-antipodal geometry is unsupported."}); END;
        END;
      END;
    END;
    IF c==7 THEN
      r:=SC_FORM("Combined distance factor",{"Point grid scale k","Mean ellipsoidal height (m)","Distance (m)","Mode: 1 ground to grid / 0 grid to ground"},{0.9996,0,100,1});
      IF SIZE(r)>0 THEN
        IF (r(1)>0) AND (r(2)>-6300000) AND ((r(4)==0) OR (r(4)==1)) THEN
          k:=r(1)*6371000/(6371000+r(2)); a:=r(3)/k; IF r(4)==1 THEN a:=r(3)*k; END;
          SC_SHOW("Distance reduction",{"Combined factor: "+STRING(k),"Output distance: "+SC_FMT(a)+" m","Mean-radius height reduction.","Use ellipsoidal height; h = RL + geoid N."});
        END;
      END;
    END;
    IF c==8 THEN
      i:=SC_MENU("Grid operations",{"Radiate grid bearing / grid distance","Set block E / N / height shift","Apply block shift to coordinate"});
      IF i==1 THEN
        p:=SC_POINT("Grid start point"); b:=SC_BEAR("Grid bearing",0); r:=SC_NUM("Grid radiation","Grid distance (m)","Positive distance; reduce ground distance first",1);
        IF (SIZE(p)>0) AND (SIZE(b)>0) AND r(1) THEN IF r(2)>0 THEN out:=SC_RAD(p(1),p(2),b(1),r(2)); SC_STORE({out(1),out(2),p(3)}); END; END;
      END;
      IF i==2 THEN r:=SC_FORM("Block shift",{"Shift E (m)","Shift N (m)","Shift height (m)"},SC_BLOCK); IF SIZE(r)>0 THEN SC_BLOCK:=r; END; END;
      IF i==3 THEN p:=SC_POINT("Point to shift"); IF SIZE(p)>0 THEN SC_STORE({p(1)+SC_BLOCK(1),p(2)+SC_BLOCK(2),p(3)+SC_BLOCK(3)}); END; END;
    END;
    IF c==9 THEN SC_GDATA(); END;
  UNTIL 0;
END;

SC_GDATA()
BEGIN
  LOCAL c,r,i,j,found,lines,p,valid;
  REPEAT
    c:=SC_MENU("GEODETIC POINT JOBS",{"View latitude / longitude / h","Add / replace point","Delete point","Save job with projection","Open saved job","Export CSV to SC_TEXT","Import SC_GROWS","Delete saved job"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      lines:={};
      FOR i FROM 1 TO SIZE(SC_GPOINTS) DO
        p:=SC_GPOINTS(i);
        lines:=CONCAT(lines,{"ID "+STRING(p(1))+"  h "+SC_FMT(p(4)),"Lat "+STRING(p(2)),"Lon "+STRING(p(3))});
      END;
      SC_SHOW("Geodetic coordinates",CONCAT(lines,{"End of list. Heights are ellipsoidal."}));
    END;
    IF c==2 THEN
      r:=SC_FORM("Geodetic point",{"Positive integer ID","Latitude decimal deg","Longitude decimal deg","Ellipsoidal height (m)"},{SIZE(SC_GPOINTS)+1,-33,151,0});
      IF SIZE(r)>0 THEN
        IF (r(1)>0) AND (r(1)==FLOOR(r(1))) AND (ABS(r(2))<=90) AND (ABS(r(3))<=180) THEN
          found:=0;
          FOR i FROM 1 TO SIZE(SC_GPOINTS) DO IF SC_GPOINTS(i)(1)==r(1) THEN found:=i; END; END;
          IF found==0 THEN SC_GPOINTS:=CONCAT(SC_GPOINTS,{r});
          ELSE IF SC_MENU("Replace geodetic point?",{"Keep point","Replace point"})==2 THEN SC_GPOINTS(found):=r; END; END;
        ELSE SC_SHOW("Invalid point",{"Check ID and latitude / longitude range."}); END;
      END;
    END;
    IF c==3 THEN
      r:=SC_NUM("Delete geodetic point","Point ID","Confirmation required",1);
      IF r(1) THEN
        found:=0; FOR i FROM 1 TO SIZE(SC_GPOINTS) DO IF SC_GPOINTS(i)(1)==r(2) THEN found:=i; END; END;
        IF found>0 THEN IF SC_MENU("Delete geodetic point?",{"Keep point","Delete point"})==2 THEN SC_GPOINTS:=SC_DELETE(SC_GPOINTS,found); END; END;
      END;
    END;
    IF c==4 THEN
      SC_GJOBS:=CONCAT(SC_GJOBS,{{SC_GPOINTS,SC_PROJ}});
      SC_SHOW("Geodetic job saved",{"Job "+STRING(SIZE(SC_GJOBS)),"Coordinates and projection parameters saved."});
    END;
    IF (c==5) OR (c==8) THEN
      r:=SC_NUM("Saved geodetic jobs","Job number","Available: "+STRING(SIZE(SC_GJOBS)),1);
      IF r(1) THEN
        i:=r(2);
        IF (i>=1) AND (i<=SIZE(SC_GJOBS)) AND (i==FLOOR(i)) THEN
          IF SC_MENU("Confirm job action",{"Cancel","Proceed"})==2 THEN
            IF c==5 THEN SC_GPOINTS:=SC_GJOBS(i)(1); SC_PROJ:=SC_GJOBS(i)(2);
            ELSE SC_GJOBS:=SC_DELETE(SC_GJOBS,i); END;
          END;
        END;
      END;
    END;
    IF c==6 THEN
      SC_TEXT:="id,latitude_deg,longitude_deg,ellipsoidal_height_m";
      FOR i FROM 1 TO SIZE(SC_GPOINTS) DO
        p:=SC_GPOINTS(i); SC_TEXT:=SC_TEXT+CHAR(10)+STRING(p(1))+","+STRING(p(2))+","+STRING(p(3))+","+STRING(p(4));
      END;
      SC_SHOW("Geodetic CSV ready",{"Retrieve SC_TEXT using Connectivity Kit."});
    END;
    IF c==7 THEN
      valid:=1;
      IFERR
        FOR i FROM 1 TO SIZE(SC_GROWS) DO
          IF SIZE(SC_GROWS(i))<>4 THEN valid:=0; ELSE
            FOR j FROM 1 TO 4 DO IF TYPE(SC_GROWS(i)(j))<>0 THEN valid:=0; END; END;
            p:=SC_GROWS(i);
            IF (p(1)<1) OR (p(1)<>FLOOR(p(1))) OR (ABS(p(2))>90) OR (ABS(p(3))>180) THEN valid:=0; END;
            FOR j FROM 1 TO i-1 DO IF SC_GROWS(j)(1)==p(1) THEN valid:=0; END; END;
          END;
        END;
      THEN valid:=0; END;
      IF valid AND (SIZE(SC_GROWS)>0) THEN
        IF SC_MENU("Replace geodetic points?",{"Cancel","Import SC_GROWS"})==2 THEN SC_GPOINTS:=SC_GROWS; END;
      ELSE SC_SHOW("No valid geodetic rows",{"Set SC_GROWS to {{ID,lat,lon,h},...}.","Use unique IDs and decimal degrees."}); END;
    END;
  UNTIL 0;
END;

// Every interaction uses GETKEY. Touch input is never read.
SC_KEY()
BEGIN
  LOCAL k;
  REPEAT k:=GETKEY; WAIT(0.02); UNTIL k>=0;
  RETURN k;
END;

SC_DIGIT(k)
BEGIN
  LOCAL keys:={47,42,43,44,37,38,39,32,33,34},i;
  FOR i FROM 1 TO 10 DO
    IF k==keys(i) THEN RETURN i-1; END;
  END;
  RETURN -1;
END;

SC_FRAME(title,hint)
BEGIN
  RECT_P(0,0,319,239,RGB(247,249,252));
  RECT_P(0,0,319,30,RGB(22,47,66));
  TEXTOUT_P(title,9,6,2,RGB(255,255,255));
  LINE_P(0,216,319,216,RGB(201,210,218));
  TEXTOUT_P(hint,7,222,1,RGB(47,66,80));
END;

SC_MENU(title,items)
BEGIN
  LOCAL sel:=1,k,d,i,first;
  REPEAT
    SC_FRAME(title,"1-9 select  Arrows move  Enter OK  Esc back");
    first:=1+7*FLOOR((sel-1)/7);
    FOR i FROM first TO MIN(first+6,SIZE(items)) DO
      IF i==sel THEN
        RECT_P(5,35+24*(i-first),314,57+24*(i-first),RGB(217,236,241));
      END;
      TEXTOUT_P(STRING(i)+"  "+items(i),12,39+24*(i-first),2,RGB(20,43,58));
    END;
    k:=SC_KEY(); d:=SC_DIGIT(k);
    IF k==4 THEN RETURN 0; END;
    IF (d>=1) AND (d<=SIZE(items)) THEN RETURN d; END;
    IF k==2 THEN sel:=1+((sel+SIZE(items)-2) MOD SIZE(items)); END;
    IF k==12 THEN sel:=1+(sel MOD SIZE(items)); END;
    IF k==30 THEN RETURN sel; END;
  UNTIL 0;
END;

SC_SHOW(title,lines)
BEGIN
  LOCAL pos:=1,k,i,wrapped:={},s,cut;
  FOR i FROM 1 TO SIZE(lines) DO
    s:=lines(i);
    WHILE SIZE(s)>43 DO
      cut:=43;
      WHILE (cut>20) AND (MID(s,cut,1)<>" ") DO cut:=cut-1; END;
      IF cut==20 THEN cut:=43; END;
      wrapped:=CONCAT(wrapped,{LEFT(s,cut)}); s:=RIGHT(s,SIZE(s)-cut);
    END;
    wrapped:=CONCAT(wrapped,{s});
  END;
  lines:=wrapped;
  REPEAT
    SC_FRAME(title,"Up/Down page  Enter or Esc return");
    FOR i FROM pos TO MIN(pos+7,SIZE(lines)) DO
      TEXTOUT_P(lines(i),10,39+21*(i-pos),2,RGB(20,43,58));
    END;
    k:=SC_KEY();
    IF (k==30) OR (k==4) THEN RETURN 0; END;
    IF k==12 THEN pos:=MIN(MAX(1,SIZE(lines)-7),pos+8); END;
    IF k==2 THEN pos:=MAX(1,pos-8); END;
  UNTIL 0;
END;

SC_NUM(title,label,help,initial)
BEGIN
  LOCAL text:=STRING(initial),fresh:=1,k,d,x,ok;
  REPEAT
    SC_FRAME(title,"Digits . +/- EEX  Backspace  Enter OK  Esc cancel");
    TEXTOUT_P(LEFT(label,43),10,42,2,RGB(20,43,58));
    IF SIZE(label)>43 THEN TEXTOUT_P(RIGHT(label,SIZE(label)-43),10,62,1,RGB(47,66,80)); END;
    RECT_P(8,87,311,121,RGB(217,236,241));
    TEXTOUT_P(text,13,94,3,RGB(20,43,58));
    TEXTOUT_P(LEFT(help,50),10,140,1,RGB(47,66,80));
    IF SIZE(help)>50 THEN TEXTOUT_P(RIGHT(help,SIZE(help)-50),10,156,1,RGB(47,66,80)); END;
    TEXTOUT_P("Enter keeps the displayed value.",10,185,1,RGB(47,66,80));
    k:=SC_KEY(); d:=SC_DIGIT(k);
    IF k==4 THEN RETURN {0,0}; END;
    IF k==30 THEN
      ok:=1;
      IFERR x:=EXPR(text); THEN ok:=0; END;
      IF ok AND (TYPE(x)==0) THEN
        IF ABS(x)<1E99 THEN RETURN {1,x}; END;
      END;
      SC_SHOW("Invalid number",{"Enter a real number.","Example: 123.456 or -1.25"});
    END;
    IF (d>=0) OR (k==48) THEN
      IF fresh THEN text:=""; fresh:=0; END;
      IF SIZE(text)<18 THEN
        IF d>=0 THEN text:=text+STRING(d); END;
        IF k==48 THEN text:=text+"."; END;
      END;
    END;
    IF k==19 THEN
      fresh:=0;
      IF SIZE(text)>1 THEN text:=LEFT(text,SIZE(text)-1); ELSE text:=""; END;
    END;
    IF (k==27) OR (k==45) THEN
      fresh:=0;
      IF LEFT(text,1)=="-" THEN text:=RIGHT(text,SIZE(text)-1); ELSE text:="-"+text; END;
    END;
    IF k==31 THEN fresh:=0; text:=text+"E"; END;
  UNTIL 0;
END;

SC_ASK(title,labels,helps,values)
BEGIN
  LOCAL out:={},i,r;
  FOR i FROM 1 TO SIZE(labels) DO
    r:=SC_NUM(title+" "+STRING(i)+"/"+STRING(SIZE(labels)),labels(i),helps(i),values(i));
    IF r(1)==0 THEN RETURN {}; END;
    out:=CONCAT(out,{r(2)});
  END;
  RETURN out;
END;

SC_FMT(x)
BEGIN
  RETURN STRING(ROUND(x,4));
END;

SC_ANGLE(a)
BEGIN
  LOCAL t,d,m,s,sign:="";
  IF a<0 THEN sign:="-"; END;
  t:=ROUND(ABS(a)*3600,2); d:=FLOOR(t/3600);
  t:=t-3600*d; m:=FLOOR(t/60); s:=t-60*m;
  RETURN sign+STRING(d)+"d "+STRING(m)+"m "+STRING(s)+"s";
END;

SC_BEAR(title,initial)
BEGIN
  LOCAL r;
  REPEAT
    r:=SC_NUM(title,"Azimuth DD.MMSS","Clockwise from North. 123.3045 = 123d30m45s",initial);
    IF r(1)==0 THEN RETURN {}; END;
    IF SC_DMSOK(r(2)) AND (r(2)>=0) AND (r(2)<360) THEN
      RETURN {SC_DEC(r(2))};
    END;
    SC_SHOW("Invalid bearing",{"Use 0 <= bearing < 360 degrees.","Minutes and seconds must be below 60."});
  UNTIL 0;
END;

SC_MISSINGUI()
BEGIN
  LOCAL c,r,e,n,a,b,d,sol,opts,pick,newlegs,lines,i;
  IF SIZE(SC_LEGS)==0 THEN SC_SHOW("Missing elements",{"Enter the known legs first.","Unknown legs are appended to the lot."}); RETURN 0; END;
  c:=SC_MENU("Missing closing elements",{"One complete missing leg","Two unknown distances","Two unknown bearings","One bearing / one distance"});
  IF c==0 THEN RETURN 0; END;
  r:=SC_CLOSE(SC_LEGS); e:=-r(1); n:=-r(2); opts:={}; lines:={};
  IF c==1 THEN
    IF r(3)<1E-9 THEN SC_SHOW("Already closed",{"No positive missing leg is required."}); RETURN 0; END;
    opts:={{{SC_AZ(e,n),r(3),0}}};
  END;
  IF c==2 THEN
    a:=SC_BEAR("First missing bearing",0); IF SIZE(a)==0 THEN RETURN 0; END;
    b:=SC_BEAR("Second missing bearing",90); IF SIZE(b)==0 THEN RETURN 0; END;
    sol:=SC_2DIST(e,n,a(1),b(1));
    IF SIZE(sol)>0 THEN opts:={{{a(1),sol(1),0},{b(1),sol(2),0}}}; END;
  END;
  IF c==3 THEN
    d:=SC_ASK("Known distances",{"First distance (m)","Second distance (m)"},{"Positive length","Positive length"},{1,1});
    IF SIZE(d)==0 THEN RETURN 0; END;
    sol:=SC_2BEAR(e,n,d(1),d(2));
    IF SIZE(sol)>0 THEN
      opts:={{{sol(1),d(1),0},{sol(2),d(2),0}},{{sol(3),d(1),0},{sol(4),d(2),0}}};
    END;
  END;
  IF c==4 THEN
    d:=SC_NUM("Known length","Length of unknown-bearing leg (m)","First missing leg; positive length",1);
    IF d(1)==0 THEN RETURN 0; END;
    b:=SC_BEAR("Known bearing of second leg",0); IF SIZE(b)==0 THEN RETURN 0; END;
    IF d(2)>0 THEN
      sol:=SC_MIXED(e,n,d(2),b(1));
      FOR i FROM 1 TO SIZE(sol) DO
        opts:=CONCAT(opts,{{{sol(i)(1),d(2),0},{b(1),sol(i)(2),0}}});
      END;
    END;
  END;
  IF SIZE(opts)==0 THEN SC_SHOW("No unique positive solution",{"Geometry is singular or impossible.","Check bearings and distances."}); RETURN 0; END;
  FOR i FROM 1 TO SIZE(opts) DO
    lines:={};
    FOR pick FROM 1 TO SIZE(opts(i)) DO
      lines:=CONCAT(lines,{"Leg "+STRING(pick)+": "+SC_ANGLE(opts(i)(pick)(1)),"Distance: "+SC_FMT(opts(i)(pick)(2))+" m"});
    END;
    SC_SHOW("Solution "+STRING(i)+" of "+STRING(SIZE(opts)),lines);
    IF SC_MENU("Use this solution?",{"Keep observations unchanged","Append these closing legs"})==2 THEN
      SC_LEGS:=CONCAT(SC_LEGS,opts(i)); SC_ADJUSTED:={}; RETURN 0;
    END;
  END;
END;

// Persistent data is namespaced; no use of the user's matrices or lists.






SC_NEWLEG(initial)
BEGIN
  LOCAL b,r,t,seg:=0;
  b:=SC_BEAR("Lot leg",SC_PACK(initial(1)));
  IF SIZE(b)==0 THEN RETURN {}; END;
  r:=SC_NUM("Lot leg","Distance (m)","Positive straight length or curve chord",initial(2));
  IF r(1)==0 THEN RETURN {}; END;
  IF r(2)<=0 THEN SC_SHOW("Invalid distance",{"Distance must be greater than zero."}); RETURN {}; END;
  t:=SC_MENU("Boundary type",{"Straight","Curve: add segment area","Curve: subtract segment area"});
  IF t==0 THEN RETURN {}; END;
  IF t>1 THEN
    seg:=SC_NUM("Circular boundary","Radius (m)","Minor arc only; radius >= half the chord",r(2));
    IF seg(1)==0 THEN RETURN {}; END;
    IF (seg(2)<=0) OR (2*seg(2)<r(2)) THEN
      SC_SHOW("Invalid curve",{"Radius must be >= half the chord."}); RETURN {};
    END;
    seg:=SC_SEG(seg(2),r(2));
    IF t==3 THEN seg:=-seg; END;
  END;
  RETURN {b(1),r(2),seg};
END;

SC_REPORT(legs,title)
BEGIN
  LOCAL r,lines,pc;
  IF SIZE(legs)==0 THEN SC_SHOW(title,{"No legs. Choose Add leg first."}); RETURN 0; END;
  r:=SC_CLOSE(legs);
  lines:={"Legs: "+STRING(SIZE(legs)),"Error E: "+SC_FMT(r(1))+" m",
    "Error N: "+SC_FMT(r(2))+" m","Misclose: "+SC_FMT(r(3))+" m",
    "Closing brg: "+SC_ANGLE(r(4)),"Chord perimeter: "+SC_FMT(r(5))+" m",
    "Area*: "+SC_FMT(r(6))+" m2","Area*: "+SC_FMT(r(6)/10000)+" ha"};
  IF r(3)<1E-9 THEN
    lines:=CONCAT(lines,{"Closure: within 1E-9 m"});
  ELSE
    lines:=CONCAT(lines,{"Ratio 1 : "+STRING(ROUND(r(7),0)),"Error bearing: "+SC_ANGLE(SC_WRAP(r(4)+180))});
  END;
  lines:=CONCAT(lines,{"*Open figure uses closing chord.","Curves use signed segment areas.","Area assumes a simple boundary.","Positive E = east; positive N = north."});
  SC_SHOW(title,lines);
END;

SC_VIEWLEGS()
BEGIN
  LOCAL lines:={},i;
  FOR i FROM 1 TO SIZE(SC_LEGS) DO
    lines:=CONCAT(lines,{STRING(i)+"  "+SC_ANGLE(SC_LEGS(i)(1)),
      "     "+SC_FMT(SC_LEGS(i)(2))+" m  seg "+SC_FMT(SC_LEGS(i)(3))});
  END;
  IF SIZE(lines)==0 THEN lines:={"No legs entered."}; END;
  SC_SHOW("Observed lot legs",lines);
END;

SC_VIEWCOORDS(legs)
BEGIN
  LOCAL pts:=SC_COORDS(legs,SC_ORIGIN(1),SC_ORIGIN(2)),lines:={},i;
  FOR i FROM 1 TO SIZE(pts) DO
    lines:=CONCAT(lines,{"Point "+STRING(i),"E "+SC_FMT(pts(i)(1))+"  N "+SC_FMT(pts(i)(2))});
  END;
  SC_SHOW("Coordinates (m)",lines);
END;

SC_EDITLOT()
BEGIN
  LOCAL c,r,i,leg;
  REPEAT
    c:=SC_MENU("Edit observed lot",{"View legs","Replace leg","Insert before leg","Delete leg","Reverse entire lot","Rotate / scale","Set origin"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN SC_VIEWLEGS(); END;
    IF (c>=2) AND (c<=4) THEN
      r:=SC_NUM("Edit lot","Leg number","Legs numbered from 1",1);
      IF r(1) THEN
        i:=r(2);
        IF (i<>FLOOR(i)) OR (i<1) OR (i>SIZE(SC_LEGS)+(c==3)) THEN
          SC_SHOW("Invalid leg",{"Choose an existing leg number.","Insert also allows the end position."});
        ELSE
          IF c==4 THEN
            IF SC_MENU("Delete this leg?",{"Keep leg","Delete leg"})==2 THEN
              SC_LEGS:=SC_DELETE(SC_LEGS,i); SC_ADJUSTED:={};
            END;
          ELSE
            leg:={0,1,0};
            IF c==2 THEN leg:=SC_LEGS(i); END;
            leg:=SC_NEWLEG(leg);
            IF SIZE(leg)>0 THEN
              IF c==2 THEN SC_LEGS(i):=leg; ELSE SC_LEGS:=SC_INSERT(SC_LEGS,i,leg); END;
              SC_ADJUSTED:={};
            END;
          END;
        END;
      END;
    END;
    IF c==5 THEN SC_LEGS:=SC_REVERSE(SC_LEGS); SC_ADJUSTED:={}; END;
    IF c==6 THEN
      r:=SC_ASK("Rotate / scale",{"Rotation DD.MMSS","Scale multiplier"},
        {"Clockwise positive; signed angle","Greater than zero. Area scales by factor squared."},{0,1});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(1)) AND (r(2)>0) THEN
          FOR i FROM 1 TO SIZE(SC_LEGS) DO
            SC_LEGS(i):={SC_WRAP(SC_LEGS(i)(1)+SC_DEC(r(1))),SC_LEGS(i)(2)*r(2),SC_LEGS(i)(3)*r(2)^2};
          END;
          SC_ADJUSTED:={};
        ELSE SC_SHOW("Invalid transform",{"Check the angle and positive scale."}); END;
      END;
    END;
    IF c==7 THEN
      r:=SC_ASK("Lot origin",{"Easting (m)","Northing (m)"},{"Planar coordinate","Planar coordinate"},SC_ORIGIN);
      IF SIZE(r)>0 THEN SC_ORIGIN:=r; END;
    END;
  UNTIL 0;
END;

SC_JOBMENU()
BEGIN
  LOCAL c,r,i,items,j;
  REPEAT
    c:=SC_MENU("Lot jobs",{"Save as new job","Open saved job","Delete saved job","New empty lot","Export current lot to SC_TEXT"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      SC_JOBS:=CONCAT(SC_JOBS,{{SC_LEGS,SC_ORIGIN}});
      SC_SHOW("Saved",{"Job "+STRING(SIZE(SC_JOBS))+" saved.","Observations and origin stored."});
    END;
    IF (c==2) OR (c==3) THEN
      r:=SC_NUM("Saved lot jobs","Job number","Available: "+STRING(SIZE(SC_JOBS)),1);
      IF r(1) THEN
        i:=r(2);
        IF (i>=1) AND (i<=SIZE(SC_JOBS)) AND (i==FLOOR(i)) THEN
          IF c==2 THEN
            IF SC_MENU("Replace working lot?",{"Cancel","Open saved job"})==2 THEN
              SC_LEGS:=SC_JOBS(i)(1); SC_ORIGIN:=SC_JOBS(i)(2); SC_ADJUSTED:={};
            END;
          ELSE
            IF SC_MENU("Delete saved job?",{"Keep saved job","Delete saved job"})==2 THEN SC_JOBS:=SC_DELETE(SC_JOBS,i); END;
          END;
        ELSE SC_SHOW("Invalid job",{"Choose a saved job number."}); END;
      END;
    END;
    IF c==4 THEN
      IF SC_MENU("Clear current lot?",{"Keep current lot","Start empty lot"})==2 THEN
        SC_LEGS:={}; SC_ORIGIN:={0,0}; SC_ADJUSTED:={};
      END;
    END;
    IF c==5 THEN
      SC_TEXT:="leg,azimuth_deg,chord_m,segment_m2";
      FOR i FROM 1 TO SIZE(SC_LEGS) DO
        SC_TEXT:=SC_TEXT+CHAR(10)+STRING(i)+","+STRING(SC_LEGS(i)(1))+","+STRING(SC_LEGS(i)(2))+","+STRING(SC_LEGS(i)(3));
      END;
      SC_SHOW("Export ready",{"CSV stored in SC_TEXT.","Retrieve the variable using Connectivity Kit.","Saved jobs remain on the calculator."});
    END;
  UNTIL 0;
END;

SC_BOWUI()
BEGIN
  LOCAL c,r;
  IF SIZE(SC_LEGS)<2 THEN SC_SHOW("Bowditch",{"Enter at least two positive-length legs."}); RETURN 0; END;
  c:=SC_MENU("Bowditch target",{"Closed loop (same start/end)","Known end coordinate","View last adjusted coordinates"});
  IF c==0 THEN RETURN 0; END;
  IF c==3 THEN
    IF SIZE(SC_ADJUSTED)==0 THEN SC_SHOW("Bowditch",{"No current adjustment."}); ELSE SC_VIEWCOORDS(SC_ADJUSTED); END;
    RETURN 0;
  END;
  r:=SC_ORIGIN;
  IF c==2 THEN
    r:=SC_ASK("Known endpoint",{"End Easting (m)","End Northing (m)"},{"Fixed target coordinate","Fixed target coordinate"},SC_ORIGIN);
    IF SIZE(r)==0 THEN RETURN 0; END;
  END;
  SC_ADJUSTED:=SC_BOW(SC_LEGS,r(1)-SC_ORIGIN(1),r(2)-SC_ORIGIN(2));
  SC_REPORT(SC_ADJUSTED,"Bowditch adjusted (copy)");
END;

SC_LOT()
BEGIN
  LOCAL c,leg;
  REPEAT
    c:=SC_MENU("LOT CLOSE | "+STRING(SIZE(SC_LEGS))+" legs",{"Add leg","Misclose and area","View / edit legs","Coordinates","Bowditch adjustment","Save / open / new lot","Missing elements","Copy coordinates to point database","Undo last leg"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      leg:=SC_NEWLEG({0,1,0});
      IF SIZE(leg)>0 THEN SC_LEGS:=CONCAT(SC_LEGS,{leg}); SC_ADJUSTED:={}; END;
    END;
    IF c==2 THEN SC_REPORT(SC_LEGS,"Lot closure and area"); END;
    IF c==3 THEN SC_EDITLOT(); END;
    IF c==4 THEN SC_VIEWCOORDS(SC_LEGS); END;
    IF c==5 THEN SC_BOWUI(); END;
    IF c==6 THEN SC_JOBMENU(); END;
    IF c==7 THEN SC_MISSINGUI(); END;
    IF c==8 THEN SC_LOTPOINTS(); END;
    IF c==9 THEN
      IF SIZE(SC_LEGS)>0 THEN
        IF SC_MENU("Remove last entered leg?",{"Keep leg","Undo last leg"})==2 THEN SC_LEGS:=SC_DELETE(SC_LEGS,SIZE(SC_LEGS)); SC_ADJUSTED:={}; END;
      END;
    END;
  UNTIL 0;
END;

SC_LOTPOINTS()
BEGIN
  LOCAL r,pts,i,id,j,collision:=0,rows;
  IF SIZE(SC_LEGS)==0 THEN SC_SHOW("Lot to points",{"Enter lot legs first."}); RETURN 0; END;
  r:=SC_FORM("Lot to point database",{"First positive point ID","Height for all copied points (m)"},{1,0});
  IF SIZE(r)==0 THEN RETURN 0; END;
  IF (r(1)<1) OR (r(1)<>FLOOR(r(1))) THEN SC_SHOW("Invalid ID",{"Use a positive integer."}); RETURN 0; END;
  pts:=SC_COORDS(SC_LEGS,SC_ORIGIN(1),SC_ORIGIN(2));
  FOR i FROM 1 TO SIZE(pts) DO IF SC_FIND(r(1)+i-1)>0 THEN collision:=1; END; END;
  IF collision THEN
    IF SC_MENU("Some point IDs already exist",{"Cancel","Replace those IDs"})<>2 THEN RETURN 0; END;
  ELSE
    IF SC_MENU("Copy all chord endpoints?",{"Cancel","Copy coordinates"})<>2 THEN RETURN 0; END;
  END;
  rows:=SC_POINTS;
  FOR i FROM 1 TO SIZE(pts) DO
    id:=r(1)+i-1; j:=SC_FIND(id);
    IF j>0 THEN rows(j):={id,pts(i)(1),pts(i)(2),r(2)};
    ELSE rows:=CONCAT(rows,{{id,pts(i)(1),pts(i)(2),r(2)}}); END;
  END;
  SC_POINTS:=rows;
  SC_SHOW("Lot coordinates copied",{STRING(SIZE(pts))+" points copied.","Start and final endpoint both included."});
END;

SC_ANGLES()
BEGIN
  LOCAL c,r,a,b,ans;
  REPEAT
    c:=SC_MENU("ANGLES | DD.MMSS entry",{"Add angles","Subtract angles (A - B)","Back bearing","Wrap angle to 0..360","Quadrant bearing to azimuth"});
    IF c==0 THEN RETURN 0; END;
    IF c<=2 THEN
      r:=SC_ASK("Angle arithmetic",{"Angle A DD.MMSS","Angle B DD.MMSS"},{"Signed angle; e.g. 12.3045","Minutes/seconds below 60"},{0,0});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(1)) AND SC_DMSOK(r(2)) THEN
          ans:=SC_DEC(r(1))+SC_DEC(r(2));
          IF c==2 THEN ans:=SC_DEC(r(1))-SC_DEC(r(2)); END;
          SC_SHOW("Angle result",{"Signed: "+SC_ANGLE(ans),"DD.MMSS: "+STRING(SC_PACK(ans)),
            "Decimal: "+STRING(ans),"Wrapped: "+SC_ANGLE(SC_WRAP(ans))});
        ELSE SC_SHOW("Invalid DMS",{"Minutes and seconds must be below 60."}); END;
      END;
    END;
    IF (c==3) OR (c==4) THEN
      r:=SC_NUM("Angle","Angle DD.MMSS","Signed angle",0);
      IF r(1) THEN
        IF SC_DMSOK(r(2)) THEN
          a:=SC_DEC(r(2)); IF c==3 THEN a:=a+180; END;
          SC_SHOW("Bearing result",{SC_ANGLE(SC_WRAP(a)),"DD.MMSS: "+STRING(SC_PACK(SC_WRAP(a)))});
        ELSE SC_SHOW("Invalid DMS",{"Minutes and seconds must be below 60."}); END;
      END;
    END;
    IF c==5 THEN
      b:=SC_MENU("Quadrant",{"N angle E","S angle E","S angle W","N angle W"});
      IF b>0 THEN
        r:=SC_NUM("Quadrant angle","Angle DD.MMSS","Between 0 and 90 degrees",0);
        IF r(1) THEN
          IF SC_DMSOK(r(2)) AND (r(2)>=0) AND (r(2)<=90) THEN
            a:=SC_DEC(r(2));
            IF b==2 THEN a:=180-a; END;
            IF b==3 THEN a:=180+a; END;
            IF b==4 THEN a:=360-a; END;
            SC_SHOW("Azimuth",{SC_ANGLE(SC_WRAP(a)),"DD.MMSS: "+STRING(SC_PACK(SC_WRAP(a)))});
          ELSE SC_SHOW("Invalid quadrant angle",{"Use 0 to 90 degrees in DD.MMSS."}); END;
        END;
      END;
    END;
  UNTIL 0;
END;

SC_CONVERT()
BEGIN
  LOCAL c,u,v,r,x,units;
  REPEAT
    c:=SC_MENU("CONVERSIONS",{"DMS to decimal degrees","Decimal degrees to DMS","Degrees / radians / gon","Distance units","Area units","Acres / roods / perches"});
    IF c==0 THEN RETURN 0; END;
    IF c<=2 THEN
      r:=SC_NUM("Angle conversion","Angle","DMS uses DD.MMSS; decimal uses degrees",0);
      IF r(1) THEN
        IF c==1 THEN
          IF SC_DMSOK(r(2)) THEN SC_SHOW("Decimal degrees",{STRING(SC_DEC(r(2)))});
          ELSE SC_SHOW("Invalid DMS",{"Minutes and seconds must be below 60."}); END;
        ELSE SC_SHOW("DMS angle",{SC_ANGLE(r(2)),"DD.MMSS: "+STRING(SC_PACK(r(2)))}); END;
      END;
    END;
    IF c>=3 THEN
      IF c==3 THEN units:={"Decimal degrees","Radians","Gon (400 per turn)"}; END;
      IF c==4 THEN units:={"Metres","International feet","US survey feet","Links (international)","Chains (international)","Kilometres","Inches (international)"}; END;
      IF c==5 THEN units:={"Square metres","Hectares","Square international feet","Square US survey feet","Acres (international)","Square kilometres"}; END;
      IF c<=5 THEN
        u:=SC_MENU("Convert FROM",units);
        IF u>0 THEN
          v:=SC_MENU("Convert TO",units);
          IF v>0 THEN
            r:=SC_NUM("Conversion","Value",units(u),0);
            IF r(1) THEN
              IF c==3 THEN units:={1,180/3.141592653589793,0.9}; x:=r(2)*units(u)/units(v); END;
              IF c==4 THEN x:=r(2)*SC_DFACT(u)/SC_DFACT(v); END;
              IF c==5 THEN x:=r(2)*SC_AFACT(u)/SC_AFACT(v); END;
              SC_SHOW("Converted value",{STRING(x),"Input: "+STRING(r(2)),"From unit "+STRING(u)+" to unit "+STRING(v)});
            END;
          END;
        END;
      ELSE
        r:=SC_NUM("Acres / roods / perches","Area in square metres","International acre = 4046.8564224 m2",0);
        IF r(1) THEN
          IF r(2)<0 THEN SC_SHOW("Invalid area",{"Area must be nonnegative."});
          ELSE
            x:=r(2)/4046.8564224; u:=FLOOR(x); x:=(x-u)*4; v:=FLOOR(x); x:=(x-v)*40;
            SC_SHOW("Acres / roods / perches",{STRING(u)+" ac  "+STRING(v)+" ro  "+SC_FMT(x)+" perch"});
          END;
        END;
      END;
    END;
  UNTIL 0;
END;
















SC_FORM(title,labels,values)
BEGIN
  LOCAL helps:={},i;
  FOR i FROM 1 TO SIZE(labels) DO helps:=CONCAT(helps,{"Enter value; Esc cancels without saving."}); END;
  RETURN SC_ASK(title,labels,helps,values);
END;

SC_FIND(id)
BEGIN
  LOCAL i;
  FOR i FROM 1 TO SIZE(SC_POINTS) DO
    IF SC_POINTS(i)(1)==id THEN RETURN i; END;
  END;
  RETURN 0;
END;

SC_POINT(title)
BEGIN
  LOCAL c,r,i;
  c:=SC_MENU(title,{"Enter E / N / height","Use stored point ID"});
  IF c==0 THEN RETURN {}; END;
  IF c==1 THEN RETURN SC_FORM(title,{"Easting (m)","Northing (m)","Height (m)"},{0,0,0}); END;
  r:=SC_NUM(title,"Point ID","Numeric ID in the point database",1);
  IF r(1)==0 THEN RETURN {}; END;
  i:=SC_FIND(r(2));
  IF i==0 THEN SC_SHOW("Point not found",{"Add it using Point database."}); RETURN {}; END;
  RETURN {SC_POINTS(i)(2),SC_POINTS(i)(3),SC_POINTS(i)(4)};
END;

SC_STORE(p)
BEGIN
  LOCAL r,i;
  SC_SHOW("Computed coordinate",{"E "+SC_FMT(p(1)),"N "+SC_FMT(p(2)),"Height "+SC_FMT(p(3))});
  IF SC_MENU("Store computed point?",{"Return without storing","Store in point database"})<>2 THEN RETURN 0; END;
  r:=SC_NUM("Store point","Numeric point ID","Positive whole number",SIZE(SC_POINTS)+1);
  IF r(1)==0 THEN RETURN 0; END;
  IF (r(2)<1) OR (r(2)<>FLOOR(r(2))) THEN SC_SHOW("Invalid ID",{"Use a positive whole number."}); RETURN 0; END;
  i:=SC_FIND(r(2));
  IF i>0 THEN
    IF SC_MENU("Replace existing point?",{"Keep old point","Replace coordinates"})<>2 THEN RETURN 0; END;
    SC_POINTS(i):={r(2),p(1),p(2),p(3)};
  ELSE SC_POINTS:=CONCAT(SC_POINTS,{{r(2),p(1),p(2),p(3)}}); END;
END;

SC_POINTMENU()
BEGIN
  LOCAL c,p,r,i,lines,job,j,valid;
  REPEAT
    c:=SC_MENU("POINTS | "+STRING(SIZE(SC_POINTS)),{"View points","Add / replace point","Delete point","Rotate / scale / translate","Save / open point job","Import SC_ROWS","Export CSV to SC_TEXT"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      lines:={};
      FOR i FROM 1 TO SIZE(SC_POINTS) DO
        lines:=CONCAT(lines,{"ID "+STRING(SC_POINTS(i)(1))+"  H "+SC_FMT(SC_POINTS(i)(4)),
          "E "+SC_FMT(SC_POINTS(i)(2))+"  N "+SC_FMT(SC_POINTS(i)(3))});
      END;
      SC_SHOW("Point database",CONCAT(lines,{"End of point list"}));
    END;
    IF c==2 THEN p:=SC_POINT("Coordinate to store"); IF SIZE(p)>0 THEN SC_STORE(p); END; END;
    IF c==3 THEN
      r:=SC_NUM("Delete point","Point ID","Deletion needs confirmation",1);
      IF r(1) THEN
        i:=SC_FIND(r(2));
        IF i>0 THEN
          IF SC_MENU("Delete point "+STRING(r(2))+"?",{"Keep point","Delete point"})==2 THEN SC_POINTS:=SC_DELETE(SC_POINTS,i); END;
        END;
      END;
    END;
    IF c==4 THEN
      r:=SC_FORM("Transform all points",{"Pivot Easting","Pivot Northing","Rotation DD.MMSS","Scale","Shift Easting","Shift Northing","Height shift"},{0,0,0,1,0,0,0});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(3)) AND (r(4)>0) THEN
          FOR i FROM 1 TO SIZE(SC_POINTS) DO
            p:=SC_JOIN(r(1),r(2),SC_POINTS(i)(2),SC_POINTS(i)(3));
            p:=SC_RAD(r(1)+r(5),r(2)+r(6),p(1)+SC_DEC(r(3)),p(2)*r(4));
            SC_POINTS(i):={SC_POINTS(i)(1),p(1),p(2),SC_POINTS(i)(4)+r(7)};
          END;
        ELSE SC_SHOW("Invalid transform",{"Use valid DMS and positive scale."}); END;
      END;
    END;
    IF c==5 THEN
      j:=SC_MENU("Point jobs",{"Save snapshot as new job","Open job","Delete job"});
      IF j==1 THEN SC_POINTJOBS:=CONCAT(SC_POINTJOBS,{SC_POINTS}); SC_SHOW("Saved",{"Point job "+STRING(SIZE(SC_POINTJOBS))}); END;
      IF j>=2 THEN
        r:=SC_NUM("Point jobs","Job number","Available: "+STRING(SIZE(SC_POINTJOBS)),1);
        IF r(1) THEN
          i:=r(2);
          IF (i>=1) AND (i<=SIZE(SC_POINTJOBS)) AND (i==FLOOR(i)) THEN
            IF SC_MENU("Confirm point job action",{"Cancel","Proceed"})==2 THEN
              IF j==2 THEN SC_POINTS:=SC_POINTJOBS(i); ELSE SC_POINTJOBS:=SC_DELETE(SC_POINTJOBS,i); END;
            END;
          END;
        END;
      END;
    END;
    IF c==6 THEN
      valid:=1;
      IFERR
        FOR i FROM 1 TO SIZE(SC_ROWS) DO
          IF SIZE(SC_ROWS(i))<>4 THEN valid:=0; ELSE
            IF (SC_ROWS(i)(1)<1) OR (SC_ROWS(i)(1)<>FLOOR(SC_ROWS(i)(1))) THEN valid:=0; END;
            FOR j FROM 1 TO 4 DO IF TYPE(SC_ROWS(i)(j))<>0 THEN valid:=0; END; END;
            FOR j FROM 1 TO i-1 DO IF SC_ROWS(j)(1)==SC_ROWS(i)(1) THEN valid:=0; END; END;
          END;
        END;
      THEN valid:=0; END;
      IF valid AND (SIZE(SC_ROWS)>0) THEN
        IF SC_MENU("Replace point database?",{"Cancel","Import SC_ROWS"})==2 THEN SC_POINTS:=SC_ROWS; END;
      ELSE SC_SHOW("No valid import rows",{"Set SC_ROWS to {{ID,E,N,H},...}.","IDs must be unique positive integers."}); END;
    END;
    IF c==7 THEN
      SC_TEXT:="id,easting_m,northing_m,height_m";
      FOR i FROM 1 TO SIZE(SC_POINTS) DO
        p:=SC_POINTS(i); SC_TEXT:=SC_TEXT+CHAR(10)+STRING(p(1))+","+STRING(p(2))+","+STRING(p(3))+","+STRING(p(4));
      END;
      SC_SHOW("CSV export ready",{"Retrieve SC_TEXT using Connectivity Kit."});
    END;
  UNTIL 0;
END;

SC_COGO()
BEGIN
  LOCAL c,p,q,r,b,a,out,i,j,k,pts,id,lines,cur;
  REPEAT
    c:=SC_MENU("COORDINATE GEOMETRY",{"Point database / jobs","Radiation / traverse (2D or 3D)","Join / inverse (2D and 3D)","Line chainage / offset","Intersections","Three-point resection","Area from stored points","Two-point eccentric station","Radiation / join corrections"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN SC_POINTMENU(); END;
    IF (c>=2) AND (c<=6) THEN
      p:=SC_POINT("Reference point A"); IF SIZE(p)==0 THEN c:=-1; END;
    END;
    IF c==2 THEN
      j:=SC_MENU("Radiation observation",{"Horizontal distance","Slope distance and zenith angle"});
      IF j>0 THEN
        b:=SC_BEAR("Radiation bearing",0);
        IF SIZE(b)>0 THEN
          IF j==1 THEN
            r:=SC_FORM("Radiation",{"Horizontal distance (m)","Height difference (m)"},{1,0});
            IF SIZE(r)>0 THEN
              IF r(1)>0 THEN
                IF (SC_BCORR<>0) OR (SC_DSCALE<>1) THEN SC_SHOW("Radiation corrections",{"Bearing correction: "+SC_ANGLE(SC_BCORR),"Distance scale: "+STRING(SC_DSCALE)}); END;
                out:=SC_RAD(p(1),p(2),b(1)+SC_BCORR,r(1)*SC_DSCALE); SC_STORE({out(1),out(2),p(3)+r(2)});
              END;
            END;
          ELSE
            r:=SC_FORM("3D radiation",{"Slope distance (m)","Zenith angle DD.MMSS","Instrument height (m)","Target height (m)","Refraction k (1 disables correction)"},{1,90,0,0,0.13});
            IF SIZE(r)>0 THEN
              IF (r(1)>0) AND SC_DMSOK(r(2)) AND (r(2)>=0) AND (r(2)<=180) THEN
                IF (SC_BCORR<>0) OR (SC_DSCALE<>1) THEN SC_SHOW("Radiation corrections",{"Bearing correction: "+SC_ANGLE(SC_BCORR),"Slope distance scale: "+STRING(SC_DSCALE)}); END;
                a:=SC_HEIGHT(r(1)*SC_DSCALE,SC_DEC(r(2)),r(3),r(4),r(5));
                out:=SC_RAD(p(1),p(2),b(1)+SC_BCORR,a(1)); SC_STORE({out(1),out(2),p(3)+a(2)});
              ELSE SC_SHOW("Invalid 3D observation",{"Check positive distance and zenith angle."}); END;
            END;
          END;
        END;
      END;
    END;
    IF (c>=3) AND (c<=5) THEN q:=SC_POINT("Reference point B"); IF SIZE(q)==0 THEN c:=-1; END; END;
    IF c==3 THEN
      r:=SC_JOIN(p(1),p(2),q(1),q(2)); a:=q(3)-p(3);
      SC_SHOW("Join A to B",{"Azimuth: "+SC_ANGLE(r(1)),"Horizontal: "+SC_FMT(r(2))+" m",
        "Height diff: "+SC_FMT(a)+" m","Slope: "+SC_FMT(SQRT(r(2)^2+a^2))+" m",
        "Zenith: "+SC_ANGLE(SC_AZ(r(2),a))});
      IF (SC_BCORR<>0) OR (SC_DSCALE<>1) THEN
        SC_SHOW("Join with inverse corrections",{"Observation bearing: "+SC_ANGLE(SC_WRAP(r(1)-SC_BCORR)),"Observation distance: "+SC_FMT(r(2)/SC_DSCALE),"Raw grid results shown on previous page."});
      END;
    END;
    IF c==4 THEN
      r:=SC_JOIN(p(1),p(2),q(1),q(2));
      IF r(2)>1E-9 THEN
        j:=SC_MENU("Reference line A to B",{"Coordinate from chainage / offset","Chainage / offset of a point"});
        IF j==1 THEN
          a:=SC_FORM("Line offset",{"Distance along from A (m)","Offset right positive (m)"},{0,0});
          IF SIZE(a)>0 THEN out:=SC_CHAIN(p(1),p(2),r(1),a(1),a(2)); SC_STORE({out(1),out(2),p(3)}); END;
        END;
        IF j==2 THEN
          a:=SC_POINT("Point to project");
          IF SIZE(a)>0 THEN out:=SC_OFFSET(p(1),p(2),r(1),a(1),a(2)); SC_SHOW("Line projection",{"Along from A: "+SC_FMT(out(1))+" m","Right offset: "+SC_FMT(out(2))+" m"}); END;
        END;
      ELSE SC_SHOW("Invalid reference line",{"A and B must be different points."}); END;
    END;
    IF c==5 THEN
      j:=SC_MENU("Intersection type",{"Bearing / bearing","Distance / distance","Bearing from A / distance from B"}); out:={};
      IF j==1 THEN
        a:=SC_BEAR("Bearing from A",0); b:=SC_BEAR("Bearing from B",90);
        IF (SIZE(a)>0) AND (SIZE(b)>0) THEN
          r:=SC_BB(p(1),p(2),a(1),q(1),q(2),b(1));
          IF SIZE(r)>0 THEN
            SC_SHOW("Line intersection",{"Distance on ray A: "+SC_FMT(r(3)),"Distance on ray B: "+SC_FMT(r(4)),"Negative distance is a backward extension."}); out:={{r(1),r(2)}};
          END;
        END;
      END;
      IF j==2 THEN
        a:=SC_FORM("Circle intersection",{"Distance from A (m)","Distance from B (m)"},{1,1});
        IF SIZE(a)>0 THEN out:=SC_DD(p(1),p(2),a(1),q(1),q(2),a(2)); END;
      END;
      IF j==3 THEN
        a:=SC_BEAR("Bearing from A",0); b:=SC_NUM("Circle radius","Distance from B (m)","Positive distance",1);
        IF (SIZE(a)>0) AND b(1) THEN out:=SC_BD(p(1),p(2),a(1),q(1),q(2),b(2)); END;
      END;
      IF j>0 THEN
        IF SIZE(out)==0 THEN SC_SHOW("No intersection",{"Parallel, coincident, or impossible geometry."});
        ELSE FOR i FROM 1 TO SIZE(out) DO SC_SHOW("Solution "+STRING(i),{"Both solutions may be valid."}); SC_STORE({out(i)(1),out(i)(2),p(3)}); END; END;
      END;
    END;
    IF c==6 THEN
      q:=SC_POINT("Reference point B"); r:=SC_POINT("Reference point C");
      IF (SIZE(q)>0) AND (SIZE(r)>0) THEN
        a:=SC_BEAR("Clockwise direction B minus A",90); b:=SC_BEAR("Clockwise direction C minus A",180);
        IF (SIZE(a)>0) AND (SIZE(b)>0) THEN
          out:=SC_RESECT({p,q,r},a(1),b(1));
          IF SIZE(out)>0 THEN SC_SHOW("Resection orientation",{"Azimuth to A: "+SC_ANGLE(out(3))}); SC_STORE({out(1),out(2),0});
          ELSE SC_SHOW("Resection not unique",{"Check directions and known points.","Danger-circle / ill-conditioned cases rejected."}); END;
        END;
      END;
    END;
    IF c==7 THEN
      pts:={}; id:=1;
      REPEAT
        r:=SC_NUM("Polygon point order","Next point ID; 0 finishes","Enter boundary order, without repeating start",1);
        IF r(1)==0 THEN id:=0; ELSE id:=r(2); END;
        IF id>0 THEN
          i:=SC_FIND(id);
          IF i>0 THEN pts:=CONCAT(pts,{{SC_POINTS(i)(2),SC_POINTS(i)(3)}}); ELSE SC_SHOW("Unknown point ID",{"Choose a stored point."}); END;
        END;
      UNTIL id==0;
      IF SIZE(pts)>=3 THEN
        SC_SHOW("Polygon area",{SC_FMT(SC_POLYAREA(pts))+" m2","Assumes a simple polygon in boundary order."});
        IF SC_MENU("Use polygon as lot?",{"Keep working lot","Copy closed straight lot"})==2 THEN
          out:={};
          FOR i FROM 1 TO SIZE(pts) DO
            j:=1+(i MOD SIZE(pts)); r:=SC_JOIN(pts(i)(1),pts(i)(2),pts(j)(1),pts(j)(2));
            IF r(2)>1E-9 THEN out:=CONCAT(out,{{r(1),r(2),0}}); END;
          END;
          SC_LEGS:=out; SC_ORIGIN:=pts(1); SC_ADJUSTED:={};
        END;
      END;
    END;
    IF c==8 THEN
      p:=SC_POINT("Main station"); q:=SC_POINT("Reference object");
      IF (SIZE(p)>0) AND (SIZE(q)>0) THEN
        a:=SC_BEAR("Direction to main station",0); b:=SC_BEAR("Direction to reference object",90);
        r:=SC_NUM("Eccentric station","Horizontal distance to main (m)","Both possible solutions will be shown.",1);
        IF (SIZE(a)>0) AND (SIZE(b)>0) AND r(1) THEN
          out:=SC_ECC(p(1),p(2),q(1),q(2),r(2),SC_WRAP(b(1)-a(1)));
          IF SIZE(out)==0 THEN SC_SHOW("No eccentric solution",{"Geometry is singular or impossible."}); END;
          FOR i FROM 1 TO SIZE(out) DO SC_SHOW("Eccentric solution "+STRING(i),{"Confirm which side of the line is correct."}); SC_STORE({out(i)(1),out(i)(2),p(3)}); END;
        END;
      END;
    END;
    IF c==9 THEN
      r:=SC_FORM("Radiation / join corrections",{"Add bearing correction DD.MMSS","Multiply distance by scale"},{SC_PACK(SC_BCORR),SC_DSCALE});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(1)) AND (r(2)>0) THEN SC_BCORR:=SC_DEC(r(1)); SC_DSCALE:=r(2);
        ELSE SC_SHOW("Invalid correction",{"Check DMS and positive distance scale."}); END;
      END;
    END;
  UNTIL 0;
END;

SC_UTILS()
BEGIN
  LOCAL c,r,a,b,p,q,out,pts,i,total,which;
  REPEAT
    c:=SC_MENU("SURVEY UTILITIES",{"Circular curve components","Trig height / slope reduction","Bearing / distance components","Fixed-area cut from lot","Corner truncation chord","Missing tie measurement","Intersection secant","Reduce two-face observations"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      which:=SC_MENU("Circular curve known data",{"Radius and deflection angle","Radius and chord","Radius and arc length"});
      IF which>0 THEN
        r:=SC_FORM("Circular curve",{"Radius (m)","Deflection DD.MMSS / chord m / arc m"},{100,30});
        IF SIZE(r)>0 THEN
          a:=-1;
          IF (r(1)>0) AND (r(2)>0) THEN
            IF which==1 THEN IF SC_DMSOK(r(2)) THEN a:=SC_DEC(r(2)); END; END;
            IF which==2 THEN IF r(2)<2*r(1) THEN a:=2*ASIN(r(2)/(2*r(1))); END; END;
            IF which==3 THEN a:=r(2)/r(1)*180/3.141592653589793; END;
          END;
          IF (a>0) AND (a<180) THEN
            out:=SC_CURVE(r(1),a);
            SC_SHOW("Minor circular curve",{"Deflection: "+SC_ANGLE(a),"Arc: "+SC_FMT(out(1)),"Chord: "+SC_FMT(out(2)),"Tangent: "+SC_FMT(out(3)),
              "Mid-ordinate: "+SC_FMT(out(4)),"External: "+SC_FMT(out(5)),"Segment area: "+SC_FMT(out(6))+" m2"});
          ELSE SC_SHOW("Invalid minor curve",{"Require radius > 0 and 0 < deflection < 180."}); END;
        END;
      END;
    END;
    IF c==2 THEN
      r:=SC_FORM("Trigonometric height",{"Station RL (m)","Slope distance (m)","Zenith angle DD.MMSS","Instrument height (m)","Target height (m)","Refraction k (1 disables correction)"},{0,1,90,0,0,0.13});
      IF SIZE(r)>0 THEN
        IF (r(2)>0) AND SC_DMSOK(r(3)) AND (r(3)>=0) AND (r(3)<=180) THEN
          out:=SC_HEIGHT(r(2),SC_DEC(r(3)),r(4),r(5),r(6));
          SC_SHOW("Trig height result",{"Horizontal: "+SC_FMT(out(1))+" m","Target RL: "+SC_FMT(r(1)+out(2))+" m","Includes specified curvature/refraction."});
        ELSE SC_SHOW("Invalid observation",{"Check distance and zenith angle."}); END;
      END;
    END;
    IF c==3 THEN
      a:=SC_BEAR("Observed bearing",0); b:=SC_BEAR("Reference bearing",0);
      r:=SC_NUM("Line components","Distance (m)","Signed distance allowed",1);
      IF (SIZE(a)>0) AND (SIZE(b)>0) AND r(1) THEN
        p:=SC_RAD(0,0,a(1),r(2)); out:=SC_OFFSET(0,0,b(1),p(1),p(2));
        SC_SHOW("Reference components",{"Along: "+SC_FMT(out(1)),"Right: "+SC_FMT(out(2)),"East: "+SC_FMT(p(1)),"North: "+SC_FMT(p(2))});
      END;
    END;
    IF c==4 THEN
      IF SIZE(SC_LEGS)<3 THEN SC_SHOW("Fixed area cut",{"Enter a lot with at least three legs."});
      ELSE
        pts:=SC_COORDS(SC_LEGS,0,0); total:=SC_POLYAREA(pts);
        a:=SC_BEAR("Direction of cut line",0);
        r:=SC_NUM("Fixed area cut","Retained area (m2)","Straight boundaries only. Left side retained.",total/2);
        IF (SIZE(a)>0) AND r(1) THEN
          which:=0;
          FOR i FROM 1 TO SIZE(SC_LEGS) DO IF SC_LEGS(i)(3)<>0 THEN which:=1; END; END;
          IF (r(2)>0) AND (r(2)<total) AND (which==0) THEN
            out:=SC_CUT(pts,a(1),r(2));
            SC_SHOW("Cut line",{"Direction: "+SC_ANGLE(a(1)),"Right offset from lot origin:",SC_FMT(out(1))+" m","Retained area: "+SC_FMT(out(2))+" m2",
              "Keep side with right coordinate <= offset.","Convex straight-boundary lots only."});
          ELSE SC_SHOW("Invalid cut",{"Use a convex straight-boundary lot.","Target must be between zero and lot area."}); END;
        END;
      END;
    END;
    IF c==5 THEN
      r:=SC_FORM("Corner truncation",{"Setback along first ray (m)","Setback along second ray (m)","Included angle DD.MMSS"},{10,10,90});
      IF SIZE(r)>0 THEN
        IF (r(1)>0) AND (r(2)>0) AND SC_DMSOK(r(3)) AND (r(3)>0) AND (r(3)<180) THEN
          out:=SQRT(r(1)^2+r(2)^2-2*r(1)*r(2)*COS(SC_DEC(r(3))));
          SC_SHOW("Truncation chord",{SC_FMT(out)+" m"});
        ELSE SC_SHOW("Invalid corner",{"Check positive setbacks and angle 0..180."}); END;
      END;
    END;
    IF c==6 THEN
      a:=SC_BEAR("First observed bearing",0); b:=SC_BEAR("Second observed bearing",90);
      r:=SC_FORM("Tie measurement",{"First slope distance (m)","First zenith DD.MMSS","Second slope distance (m)","Second zenith DD.MMSS"},{10,90,10,90});
      IF (SIZE(a)>0) AND (SIZE(b)>0) AND (SIZE(r)>0) THEN
        IF SC_DMSOK(r(2)) AND SC_DMSOK(r(4)) AND (r(1)>0) AND (r(3)>0) AND (r(2)>=0) AND (r(2)<=180) AND (r(4)>=0) AND (r(4)<=180) THEN
          p:=SC_RAD(0,0,a(1),r(1)*SIN(SC_DEC(r(2)))); q:=SC_RAD(0,0,b(1),r(3)*SIN(SC_DEC(r(4))));
          out:=SC_JOIN(p(1),p(2),q(1),q(2)); total:=r(3)*COS(SC_DEC(r(4)))-r(1)*COS(SC_DEC(r(2)));
          SC_SHOW("Missing tie",{"Bearing: "+SC_ANGLE(out(1)),"Horizontal: "+SC_FMT(out(2))+" m","Height difference: "+SC_FMT(total)+" m","Slope: "+SC_FMT(SQRT(out(2)^2+total^2))+" m"});
        ELSE SC_SHOW("Invalid observations",{"Check lengths and zenith angles."}); END;
      END;
    END;
    IF c==7 THEN
      r:=SC_FORM("Road intersection secant",{"Half-width road 1 (m)","Half-width road 2 (m)","Intersection angle DD.MMSS"},{5,5,90});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(3)) AND (r(3)>0) AND (r(3)<180) AND (r(1)>0) AND (r(2)>0) THEN
          a:=SC_DEC(r(3));
          SC_SHOW("Intersection edge offsets",{"On road 1: "+SC_FMT((r(2)+r(1)*COS(a))/SIN(a)),
            "On road 2: "+SC_FMT((r(1)+r(2)*COS(a))/SIN(a)),"Measured along centrelines from intersection."});
        ELSE SC_SHOW("Invalid intersection",{"Use positive widths and angle 0..180."}); END;
      END;
    END;
    IF c==8 THEN
      r:=SC_FORM("Two-face reduction",{"Face I horizontal DD.MMSS","Face I zenith DD.MMSS","Face I slope distance (m)","Face II horizontal DD.MMSS","Face II zenith DD.MMSS","Face II slope distance (m)"},{0,90,1,180,270,1});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(1)) AND SC_DMSOK(r(2)) AND SC_DMSOK(r(4)) AND SC_DMSOK(r(5)) AND
          (r(1)>=0) AND (r(1)<360) AND (r(4)>=0) AND (r(4)<360) AND
          (r(2)>=0) AND (r(2)<=180) AND (r(5)>=180) AND (r(5)<=360) AND (r(3)>0) AND (r(6)>0) THEN
          out:=SC_FACES(SC_DEC(r(1)),SC_DEC(r(2)),r(3),SC_DEC(r(4)),SC_DEC(r(5)),r(6));
          SC_SHOW("Reduced face I observation",{"Horizontal: "+SC_ANGLE(out(1)),"Zenith: "+SC_ANGLE(out(2)),"Slope: "+SC_FMT(out(3))+" m",
            "Horizontal face disagreement:",SC_ANGLE(out(4)),"Zenith index error: "+SC_ANGLE(out(5)),"Use reduced values in 3D radiation."});
        ELSE SC_SHOW("Invalid face observations",{"Face I zenith 0..180; face II 180..360.","Use valid DMS and positive distances."}); END;
      END;
    END;
  UNTIL 0;
END;

SC_LEVELUI()
BEGIN
  LOCAL c,r,out,lines,i,raw,j;
  REPEAT
    c:=SC_MENU("LEVELLING",{"Set start / known finish RL","Add backsight / foresight setup","View / adjust run","Edit / delete setup","Intermediate sight","View intermediate levels","New empty run"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      r:=SC_FORM("Level control",{"Start RL (m)","Known finish RL (m)"},{SC_LSTART,SC_LFINISH});
      IF SIZE(r)>0 THEN SC_LSTART:=r(1); SC_LFINISH:=r(2); END;
    END;
    IF c==2 THEN
      r:=SC_FORM("Level setup",{"Backsight (m)","Foresight (m)","Setup distance (m)"},{1,1,1});
      IF SIZE(r)>0 THEN
        IF (r(1)>=0) AND (r(2)>=0) AND (r(3)>0) THEN SC_LROWS:=CONCAT(SC_LROWS,{r});
        ELSE SC_SHOW("Invalid setup",{"Sight readings >= 0, distance > 0."}); END;
      END;
    END;
    IF c==3 THEN
      IF SIZE(SC_LROWS)>0 THEN
        j:=SC_MENU("Distribute level misclose",{"By setup distance","Equally by setup"});
        IF j>0 THEN
          out:=SC_LEVEL(SC_LROWS,SC_LSTART,SC_LFINISH,j==1);
          lines:={"Misclose: "+SC_FMT(out(1))+" m","Setup    raw RL / adjusted RL"};
          FOR i FROM 1 TO SIZE(SC_LROWS) DO lines:=CONCAT(lines,{STRING(i)+"  "+SC_FMT(out(2)(i)(1))+" / "+SC_FMT(out(2)(i)(2))}); END;
          SC_SHOW("Reduced levels",lines);
        END;
      ELSE SC_SHOW("Level run",{"No setups entered."}); END;
    END;
    IF c==4 THEN
      r:=SC_NUM("Edit level setup","Setup number","Existing setup number",1);
      IF r(1) THEN
        i:=r(2);
        IF (i>=1) AND (i<=SIZE(SC_LROWS)) AND (i==FLOOR(i)) THEN
          j:=SC_MENU("Edit setup",{"Replace readings","Delete setup"});
          IF j==1 THEN
            r:=SC_FORM("Replace setup",{"Backsight","Foresight","Setup distance"},SC_LROWS(i));
            IF SIZE(r)>0 THEN IF (r(1)>=0) AND (r(2)>=0) AND (r(3)>0) THEN SC_LROWS(i):=r; END; END;
          END;
          IF j==2 THEN
            IF SIZE(SC_LSIGHTS)>0 THEN SC_SHOW("Intermediate sights exist",{"Clear the run before deleting setups.","This preserves sight/setup references."});
            ELSE IF SC_MENU("Delete setup?",{"Keep","Delete"})==2 THEN SC_LROWS:=SC_DELETE(SC_LROWS,i); END; END;
          END;
        END;
      END;
    END;
    IF c==5 THEN
      r:=SC_FORM("Intermediate sight",{"Setup number","Intermediate staff reading (m)"},{1,1});
      IF SIZE(r)>0 THEN
        IF (r(1)>=1) AND (r(1)<=SIZE(SC_LROWS)) AND (r(1)==FLOOR(r(1))) AND (r(2)>=0) THEN SC_LSIGHTS:=CONCAT(SC_LSIGHTS,{r});
        ELSE SC_SHOW("Invalid intermediate",{"Use an existing setup and reading >= 0."}); END;
      END;
    END;
    IF c==6 THEN
      lines:={"Raw levels; observations retained."};
      FOR i FROM 1 TO SIZE(SC_LSIGHTS) DO
        raw:=SC_LSTART;
        FOR j FROM 1 TO SC_LSIGHTS(i)(1)-1 DO raw:=raw+SC_LROWS(j)(1)-SC_LROWS(j)(2); END;
        raw:=raw+SC_LROWS(SC_LSIGHTS(i)(1))(1)-SC_LSIGHTS(i)(2);
        lines:=CONCAT(lines,{"Sight "+STRING(i)+" RL "+SC_FMT(raw)});
      END;
      SC_SHOW("Intermediate levels",lines);
      IF SIZE(SC_LSIGHTS)>0 THEN
        j:=SC_MENU("Adjusted intermediate levels",{"Return","By setup distance","Equally by setup"});
        IF j>1 THEN
          out:=SC_LEVEL(SC_LROWS,SC_LSTART,SC_LFINISH,j==2); lines:={};
          FOR i FROM 1 TO SIZE(SC_LSIGHTS) DO
            r:=SC_LSIGHTS(i)(1); raw:=SC_LSTART;
            IF r>1 THEN raw:=out(2)(r-1)(2); END;
            raw:=raw+SC_LROWS(r)(1)-SC_LSIGHTS(i)(2);
            lines:=CONCAT(lines,{"Sight "+STRING(i)+" adjusted RL "+SC_FMT(raw)});
          END;
          SC_SHOW("Adjusted intermediate levels",CONCAT(lines,{"Correction at setup's backsight point used.","Sight position within setup is not observed."}));
        END;
      END;
    END;
    IF c==7 THEN IF SC_MENU("Clear level observations?",{"Keep run","Clear run"})==2 THEN SC_LROWS:={}; SC_LSIGHTS:={}; END; END;
  UNTIL 0;
END;

SC_ATRAVUI()
BEGIN
  LOCAL c,r,b,legs,i,lines,total;
  REPEAT
    c:=SC_MENU("ANGLE TRAVERSE",{"Set initial backsight bearing","Add clockwise turn / distance","View computed bearings","Copy computed legs to lot","Clear observations","Balance angle sum","View balanced bearings","Copy balanced legs to lot"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN b:=SC_BEAR("Initial backsight azimuth",SC_PACK(SC_TSTART)); IF SIZE(b)>0 THEN SC_TSTART:=b(1); END; END;
    IF c==2 THEN
      r:=SC_FORM("Angle traverse observation",{"Clockwise turn from backsight DD.MMSS","Forward horizontal distance (m)"},{90,1});
      IF SIZE(r)>0 THEN
        IF SC_DMSOK(r(1)) AND (r(1)>=0) AND (r(1)<360) AND (r(2)>0) THEN SC_TURNS:=CONCAT(SC_TURNS,{{SC_DEC(r(1)),r(2)}}); SC_TBALANCED:={};
        ELSE SC_SHOW("Invalid observation",{"Turn 0..360 DMS; distance > 0."}); END;
      END;
    END;
    IF (c==3) OR (c==4) OR (c==7) OR (c==8) THEN
      r:=SC_TURNS;
      IF c>=7 THEN r:=SC_TBALANCED; END;
      b:=SC_TSTART; legs:={}; lines:={};
      FOR i FROM 1 TO SIZE(r) DO
        b:=SC_WRAP(b+r(i)(1)); legs:=CONCAT(legs,{{b,r(i)(2),0}});
        lines:=CONCAT(lines,{STRING(i)+"  "+SC_ANGLE(b)+"  "+SC_FMT(r(i)(2))+" m"}); b:=SC_WRAP(b+180);
      END;
      IF (c==3) OR (c==7) THEN SC_SHOW("Computed traverse",CONCAT(lines,{"Original observed angles retained."})); END;
      IF ((c==4) OR (c==8)) AND (SIZE(legs)>0) THEN
        IF SC_MENU("Replace working lot?",{"Keep lot","Copy computed legs"})==2 THEN SC_LEGS:=legs; SC_ADJUSTED:={}; END;
      END;
    END;
    IF c==5 THEN IF SC_MENU("Clear angle traverse?",{"Keep observations","Clear observations"})==2 THEN SC_TURNS:={}; SC_TBALANCED:={}; END; END;
    IF c==6 THEN
      IF SIZE(SC_TURNS)>=3 THEN
        r:=SC_NUM("Angular balance","Required angle sum (decimal degrees)","Interior n-gon: (n-2)*180. Set correct convention.",(SIZE(SC_TURNS)-2)*180);
        IF r(1) THEN
          total:=0; FOR i FROM 1 TO SIZE(SC_TURNS) DO total:=total+SC_TURNS(i)(1); END;
          b:=(r(2)-total)/SIZE(SC_TURNS); legs:={};
          FOR i FROM 1 TO SIZE(SC_TURNS) DO legs:=CONCAT(legs,{{SC_TURNS(i)(1)+b,SC_TURNS(i)(2)}}); END;
          SC_SHOW("Angular balance",{"Observed sum: "+SC_ANGLE(total),"Correction per angle: "+SC_ANGLE(b),"Original observations retained."});
          IF SC_MENU("Keep balanced copy?",{"Cancel","Save balanced angles"})==2 THEN SC_TBALANCED:=legs; END;
        END;
      ELSE SC_SHOW("Angular balance",{"Enter at least three observed turns."}); END;
    END;
  UNTIL 0;
END;

SC_ROADUI()
BEGIN
  LOCAL c,r,a,i,p,lines,len;
  REPEAT
    c:=SC_MENU("ROAD ALIGNMENT",{"Set origin / bearing / chainage","Add straight","Add circular arc","Add clothoid transition","View elements","Set out chainage / offset","Clear alignment","Find chainage / offset of a point"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN
      r:=SC_FORM("Alignment origin",{"Easting (m)","Northing (m)","Start azimuth DD.MMSS","Start chainage (m)"},{SC_ROADORIGIN(1),SC_ROADORIGIN(2),SC_PACK(SC_ROADORIGIN(3)),SC_ROADORIGIN(4)});
      IF SIZE(r)>0 THEN IF SC_DMSOK(r(3)) THEN SC_ROADORIGIN:={r(1),r(2),SC_WRAP(SC_DEC(r(3))),r(4)}; END; END;
    END;
    IF c==2 THEN
      r:=SC_NUM("Straight element","Length (m)","Positive length",1);
      IF r(1) THEN IF r(2)>0 THEN SC_ROADLEGS:=CONCAT(SC_ROADLEGS,{{r(2),0,0}}); END; END;
    END;
    IF c==3 THEN
      r:=SC_FORM("Circular element",{"Arc length (m)","Signed radius (m); right positive"},{10,100});
      IF SIZE(r)>0 THEN
        IF (r(1)>0) AND (r(2)<>0) THEN
          IF r(1)/ABS(r(2))<=3.141592653589793 THEN SC_ROADLEGS:=CONCAT(SC_ROADLEGS,{{r(1),1/r(2),1/r(2)}});
          ELSE SC_SHOW("Subdivide this circular element",{"Each element may turn at most 180 degrees."}); END;
        ELSE SC_SHOW("Invalid circular element",{"Use positive length and nonzero radius."}); END;
      END;
    END;
    IF c==4 THEN
      r:=SC_FORM("Transition element",{"Length (m)","Entry signed radius (0 = straight)","Exit signed radius (0 = straight)"},{10,0,100});
      IF SIZE(r)>0 THEN
        IF r(1)>0 THEN
          a:={0,0}; IF r(2)<>0 THEN a(1):=1/r(2); END; IF r(3)<>0 THEN a(2):=1/r(3); END;
          IF r(1)*MAX(ABS(a(1)),ABS(a(2)))<=3.141592653589793 THEN
            SC_ROADLEGS:=CONCAT(SC_ROADLEGS,{{r(1),a(1),a(2)}});
          ELSE SC_SHOW("Subdivide this transition",{"Length times maximum curvature must be <= pi."}); END;
        END;
      END;
    END;
    IF c==5 THEN
      lines:={"Length / entry curvature / exit curvature"};
      FOR i FROM 1 TO SIZE(SC_ROADLEGS) DO
        lines:=CONCAT(lines,{STRING(i)+": "+STRING(SC_ROADLEGS(i))});
      END;
      SC_SHOW("Alignment elements",lines);
    END;
    IF c==6 THEN
      len:=SC_ROADORIGIN(4); FOR i FROM 1 TO SIZE(SC_ROADLEGS) DO len:=len+SC_ROADLEGS(i)(1); END;
      r:=SC_FORM("Alignment setout",{"Chainage (m)","Offset right positive (m)"},{SC_ROADORIGIN(4),0});
      IF SIZE(r)>0 THEN
        IF (r(1)>=SC_ROADORIGIN(4)) AND (r(1)<=len) AND (SIZE(SC_ROADLEGS)>0) THEN
          p:=SC_ROAD(SC_ROADLEGS,SC_ROADORIGIN,r(1),r(2));
          SC_SHOW("Alignment setout",{"E "+SC_FMT(p(1)),"N "+SC_FMT(p(2)),"Tangent: "+SC_ANGLE(p(3)),"Curvature: "+STRING(p(4))+" /m"});
        ELSE SC_SHOW("Chainage outside alignment",{"Range "+SC_FMT(SC_ROADORIGIN(4))+" to "+SC_FMT(len)}); END;
      END;
    END;
    IF c==7 THEN IF SC_MENU("Clear alignment?",{"Keep alignment","Clear elements"})==2 THEN SC_ROADLEGS:={}; END; END;
    IF c==8 THEN
      IF SIZE(SC_ROADLEGS)>0 THEN
        p:=SC_POINT("Point to project on alignment");
        IF SIZE(p)>0 THEN
          r:=SC_ROADNEAR(SC_ROADLEGS,SC_ROADORIGIN,p(1),p(2));
          SC_SHOW("Closest alignment position",{"Chainage: "+SC_FMT(r(1)),"Right offset: "+SC_FMT(r(2)),"Distance to alignment: "+SC_FMT(r(3)),"Along residual: "+SC_FMT(r(4)),
            "Nonzero residual indicates an endpoint.","Closest branch used if alignment overlaps."});
        END;
      ELSE SC_SHOW("No alignment",{"Enter alignment elements first."}); END;
    END;
  UNTIL 0;
END;

SC_PLUSUI()
BEGIN
  LOCAL c;
  REPEAT
    c:=SC_MENU("GEODESY / ROAD",{"Geodesy","Road alignment"});
    IF c==0 THEN RETURN 0; END;
    IF c==1 THEN SC_GEODUI(); END;
    IF c==2 THEN SC_ROADUI(); END;
  UNTIL 0;
END;

EXPORT SURVEYTEST()
BEGIN
  LOCAL old:=HAngle,r,legs,a,n:=0,failed:={},names:={},ok:={},i;
  HAngle:=0;
  IFERR
    names:={"DMS carry","DMS borrow","Reject bad minutes","Reject bad seconds",
      "Negative DMS","Wrap negative","Square closure","Square area","Back bearing",
      "Feet / metre","US survey foot","Bowditch closure","Two missing lengths",
      "Two missing bearings","Curved tutorial closure","Curved tutorial area"};
    ok:={ABS(SC_PACK(SC_DEC(12.5959)+SC_DEC(0.0002))-13.0001)<1E-8,
      ABS(SC_PACK(SC_DEC(10)-SC_DEC(0.0001))-9.5959)<1E-8,
      SC_DMSOK(12.60)==0,SC_DMSOK(12.5960)==0,
      ABS(SC_DEC(-0.30)+0.5)<1E-9,SC_WRAP(-1)==359};
    legs:={{0,100,0},{90,100,0},{180,100,0},{270,100,0}};
    r:=SC_CLOSE(legs);
    ok:=CONCAT(ok,{r(3)<1E-9,ABS(r(6)-10000)<1E-6,SC_WRAP(270+180)==90,
      ABS(SC_DFACT(2)*100-30.48)<1E-9,ABS(SC_DFACT(3)*3937-1200)<1E-9});
    legs(4):={270,99.9,0}; r:=SC_CLOSE(SC_BOW(legs,0,0));
    ok:=CONCAT(ok,{r(3)<1E-8});
    r:=SC_2DIST(100,100,0,90); ok:=CONCAT(ok,{ABS(r(1)-100)+ABS(r(2)-100)<1E-8});
    r:=SC_2BEAR(100,100,100,100); a:=SC_RAD(0,0,r(1),100); a:=SC_RAD(a(1),a(2),r(2),100);
    ok:=CONCAT(ok,{ABS(a(1)-100)+ABS(a(2)-100)<1E-8});
    legs:={{SC_DEC(36.0004),133.801,0},{SC_DEC(64.2937),35.155,SC_SEG(36.847,35.155)},
      {SC_DEC(92.5915),107.89,0},{200,159.1,0},{SC_DEC(280.58),166.701,0}};
    r:=SC_CLOSE(legs);
    ok:=CONCAT(ok,{ABS(r(3)-0.058)<0.001,ABS(r(6)-21287.96)<0.02});
    FOR i FROM 1 TO SIZE(ok) DO
      IF ok(i) THEN n:=n+1; ELSE failed:=CONCAT(failed,{names(i)}); END;
    END;
  THEN
    failed:=CONCAT(failed,{"Runtime error in self-test"});
  END;
  HAngle:=old;
  SC_SHOW("SurveyPrime self-test",CONCAT({STRING(n)+" / "+STRING(SIZE(names))+" passed"},failed));
  RETURN {n,SIZE(names),failed};
END;

EXPORT SURVEYPRIME()
BEGIN
  LOCAL old:=HAngle,fmt:=HFormat,digits:=HDigits,seps:=HSeparator,c,problem:=0;
  HAngle:=0; HFormat:=0; HDigits:=11; HSeparator:=0;
  IFERR
    REPEAT
      c:=SC_MENU("SURVEY PRIME | keypad edition",{"Lot closes","Conversions","Add / subtract angles","Coordinate geometry","Survey utilities","Levelling","Angle traverse","Geodesy / road","Help / self-test"});
      IF c==1 THEN SC_LOT(); END;
      IF c==2 THEN SC_CONVERT(); END;
      IF c==3 THEN SC_ANGLES(); END;
      IF c==4 THEN SC_COGO(); END;
      IF c==5 THEN SC_UTILS(); END;
      IF c==6 THEN SC_LEVELUI(); END;
      IF c==7 THEN SC_ATRAVUI(); END;
      IF c==8 THEN SC_PLUSUI(); END;
      IF c==9 THEN
        IF SC_MENU("Help and validation",{"Keypad guide","Run self-test"})==2 THEN SURVEYTEST();
        ELSE SC_SHOW("Keypad guide",{"Digits choose a numbered menu item.","Up/Down move; Enter selects.","Esc cancels one step or returns.","Use DD.MMSS for all DMS inputs.","Bearings clockwise from North.","All survey distances are metres.","Conversions name both units.","Working lot is retained on exit.","Save numbered jobs before editing."}); END;
      END;
    UNTIL c==0;
  THEN problem:=1; END;
  HAngle:=old; HFormat:=fmt; HDigits:=digits; HSeparator:=seps;
  IF problem THEN SC_SHOW("Calculation stopped",{"Input caused a calculation error.","Saved jobs and observations are retained.","Check the geometry and try again."}); END;
END;
